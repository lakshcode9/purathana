{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.
  Purathana Luxury Editorial Standards:
  - Dynamic canonical and viewport tags
  - Theme color set to Obsidian Basalt (#111613)
  - Strict elimination of "My Store" placeholder artifacts
  - Social Graph (Open Graph & Twitter Summary Large Card)
  - Schema.org Structured Data
{% enddoc %}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#111613">
<meta name="msapplication-TileColor" content="#111613">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Purathana">
<meta name="format-detection" content="telephone=no">

{%- liquid
  assign brand_display = 'Purathana'
  if shop.name != blank and shop.name != 'My Store'
    assign brand_display = shop.name
  endif

  assign brand_tagline = 'Traditional Cold Pressed Oils — Fresh Small Batches'
  assign default_description = 'Shop 100% pure, unrefined, chemical-free traditional cold pressed oils. Produced in small batches with zero old stock. Groundnut, Mustard, Coconut, Sesame & Sunflower oils delivered fresh across India.'
  
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif

  assign canonical_href = canonical_url | default: shop.url | append: request.path

  if template.name == 'index'
    assign seo_title = 'Purathana | Traditional Cold Pressed Oils — Fresh Small Batches, Zero Old Stock'
    assign seo_description = default_description
  elsif request.page_type == 'product'
    assign seo_title = product.title | append: ' | Cold Pressed Reserve — ' | append: brand_display
    assign seo_description = product.description | strip_html | truncatewords: 30 | default: default_description
  else
    assign page_clean_title = page_title | default: brand_display
    if page_clean_title == 'My Store'
      assign page_clean_title = brand_display
    endif
    assign seo_title = page_clean_title | append: ' — ' | append: brand_display
    assign seo_description = page_description | default: default_description
  endif
-%}

<title>{{ seo_title }}</title>
<link rel="canonical" href="{{ canonical_href }}">
<meta name="description" content="{{ seo_description | escape }}">
<meta name="keywords" content="Purathana, cold pressed oil, wood pressed oil, wood pressed groundnut oil, virgin coconut oil, gingelly sesame oil, kachi ghani mustard oil, unrefined cooking oil India, fresh batch oils">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:site_name" content="{{ brand_display }}">
<meta property="og:url" content="{{ canonical_href }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ seo_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | default: 'en_IN' }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- else -%}
  {%- assign default_share_img = 'purathana-half-groundnut.jpg' | asset_url -%}
  <meta property="og:image" content="https:{{ default_share_img }}">
  <meta property="og:image:secure_url" content="https:{{ default_share_img }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url }}">
{%- else -%}
  <meta name="twitter:image" content="https:{{ 'purathana-half-groundnut.jpg' | asset_url }}">
{%- endif -%}
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": "Purathana",
      "url": "{{ shop.url }}",
      "logo": "https:{{ 'purathana-half-groundnut.jpg' | asset_url }}",
      "description": "Purathana slow-extracts pure, unrefined traditional cold pressed oils below 38°C in small fresh batches with zero old warehouse inventory stored.",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": "+91-98765-43210",
        "availableLanguage": ["English", "Tamil", "Hindi"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": "Purathana",
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>
