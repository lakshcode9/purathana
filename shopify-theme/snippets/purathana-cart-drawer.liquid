<!-- ===================================================================
     PURATHANA CART DRAWER SNIPPET (Shopify Liquid)
     Implements SOW CRO rules:
     - Dynamic Free Shipping Bar (Threshold ₹999)
     - Auto 20% Discount Tracker (> ₹2999)
     - Single Coupon entry
     - Reward Points redemption
     - Jute Gift Wrapping (+₹50)
     =================================================================== -->

<div class="purathana-cart-drawer-overlay" id="PurathanaCartOverlay" onclick="closePurathanaCart()"></div>

<aside class="purathana-cart-drawer" id="PurathanaCartDrawer" aria-label="Shopping Cart">
  <!-- Header -->
  <div class="cart-header">
    <h3>
      <span>🛒 Your Heritage Cart</span>
      <span class="cart-count-badge" id="CartDrawerItemCount">{{ cart.item_count }} items</span>
    </h3>
    <button class="cart-close-btn" onclick="closePurathanaCart()" aria-label="Close Cart">✕</button>
  </div>

  <!-- Dynamic Free Shipping Meter (Threshold ₹999) -->
  <div class="free-shipping-bar-wrap">
    {% assign threshold_cents = 99900 %}
    {% assign current_cents = cart.total_price %}
    {% assign remaining_cents = threshold_cents | minus: current_cents %}
    
    <div class="shipping-bar-text" id="FreeShippingText">
      {% if current_cents >= threshold_cents %}
        <span style="color:#1F733C;">🎉 <strong>Free Express Shipping Unlocked!</strong></span>
      {% else %}
        <span>Add <strong style="color:var(--color-terracotta);">₹{{ remaining_cents | divided_by: 100 }}</strong> more for Free Express Delivery!</span>
      {% endif %}
    </div>
    <div class="shipping-progress-track">
      {% assign progress_pct = current_cents | times: 100 | divided_by: threshold_cents %}
      {% if progress_pct > 100 %}{% assign progress_pct = 100 %}{% endif %}
      <div class="shipping-progress-fill" id="FreeShippingBar" style="width: {{ progress_pct }}%;"></div>
    </div>
  </div>

  <!-- Auto 20% Discount Banner (> ₹2999) -->
  {% assign bulk_threshold_cents = 299900 %}
  <div class="bulk-discount-banner {% if current_cents >= bulk_threshold_cents %}active{% endif %}" id="CartBulkBanner">
    {% if current_cents >= bulk_threshold_cents %}
      ✨ <strong>Awesome!</strong> Flat 20% Auto-Discount applied at checkout!
    {% else %}
      {% assign more_bulk = bulk_threshold_cents | minus: current_cents | divided_by: 100 %}
      🏷️ Add ₹{{ more_bulk }} more to unlock <strong>Flat 20% OFF</strong>!
    {% endif %}
  </div>

  <!-- Items List -->
  <div class="cart-items-scroll" id="CartItemsContainer">
    {% if cart.item_count == 0 %}
      <div class="cart-empty-state">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <p>Your basket is empty.<br />Experience the pure taste of wood-pressed oils.</p>
        <a href="/collections/all" class="btn-primary" style="display:inline-block; margin-top:1rem;">Explore The Oils</a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item-row" data-line="{{ forloop.index }}">
          <div class="cart-item-thumb">
            <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" />
          </div>
          <div class="cart-item-details">
            <h4 class="cart-item-title">{{ item.product.title }}</h4>
            <span class="cart-item-variant">{{ item.variant.title }}</span>
            <div class="cart-item-bottom">
              <div class="qty-control">
                <button class="qty-btn" onclick="updateShopifyCartQty({{ forloop.index }}, {{ item.quantity | minus: 1 }})">−</button>
                <span class="qty-display">{{ item.quantity }}</span>
                <button class="qty-btn" onclick="updateShopifyCartQty({{ forloop.index }}, {{ item.quantity | plus: 1 }})">+</button>
              </div>
              <div class="cart-item-price">{{ item.final_line_price | money }}</div>
            </div>
          </div>
          <button class="cart-item-remove" onclick="updateShopifyCartQty({{ forloop.index }}, 0)" title="Remove item">✕</button>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <!-- Cart Footer & Calculation Breakdown -->
  {% if cart.item_count > 0 %}
    <div class="cart-footer">
      <!-- Upsell Toggles -->
      <div class="cart-upsell-toggles">
        <label class="toggle-option-label">
          <div style="display:flex; align-items:center; gap:0.45rem;">
            <input type="checkbox" id="ShopifyRewardPointsToggle" />
            <span>Redeem Wallet Points:</span>
          </div>
          <strong style="color:var(--color-amber-dark);">50 points (₹50)</strong>
        </label>

        <label class="toggle-option-label">
          <div style="display:flex; align-items:center; gap:0.45rem;">
            <input type="checkbox" id="ShopifyGiftWrapToggle" />
            <span>Eco Jute Gift Wrapping (+₹50)</span>
          </div>
          <span>🎁</span>
        </label>
      </div>

      <!-- Coupon Code -->
      <div class="coupon-input-wrap">
        <input type="text" id="ShopifyCouponInput" placeholder="Enter coupon (e.g. FLAT10)" />
        <button class="coupon-apply-btn" onclick="applyShopifyCoupon()">Apply</button>
      </div>

      <!-- Price Breakdown -->
      <div class="bill-row">
        <span>Subtotal:</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>
      <div class="bill-row">
        <span>Delivery:</span>
        <strong>
          {% if cart.total_price >= 99900 %}
            <span style="color:#1F733C;">FREE</span>
          {% else %}
            ₹80
          {% endif %}
        </strong>
      </div>
      <div class="bill-row total-row">
        <span>Estimated Total:</span>
        <span class="total-amount">{{ cart.total_price | money }}</span>
      </div>

      <!-- Native Shopify Checkout Button -->
      <a href="/checkout" class="btn-checkout" style="text-decoration:none;">
        <span>Proceed to Secure Checkout</span>
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  {% endif %}
</aside>

<script>
function openPurathanaCart() {
  document.getElementById('PurathanaCartOverlay')?.classList.add('active');
  document.getElementById('PurathanaCartDrawer')?.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closePurathanaCart() {
  document.getElementById('PurathanaCartOverlay')?.classList.remove('active');
  document.getElementById('PurathanaCartDrawer')?.classList.remove('active');
  document.body.style.overflow = '';
}

function updateShopifyCartQty(line, quantity) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ line: line, quantity: quantity })
  }).then(res => res.json()).then(() => window.location.reload());
}

function applyShopifyCoupon() {
  const code = document.getElementById('ShopifyCouponInput')?.value.trim();
  if (code) {
    window.location.href = `/discount/${code}?redirect=/checkout`;
  }
}
</script>
