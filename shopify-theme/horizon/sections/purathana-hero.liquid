<!-- ===================================================================
     PURATHANA HERO: 1:1 REPLICATION OF HARVEST SUNSET & STONE PEDESTAL
     =================================================================== -->

<section class="p-hero-exact" id="hero">
  <img src="{{ 'leaf-branch-side.png' | asset_url }}" class="p-nature-accent p-nature-branch-tl" style="width:130px; top:0; left:0; opacity:0.85;" alt="" />
  <img src="{{ 'leaf-branch-side.png' | asset_url }}" class="p-nature-accent p-nature-branch-tr" style="width:130px; top:0; right:0; opacity:0.85;" alt="" />
  <div class="p-hero-content">
    <div class="p-hero-eyebrow">
      <span>TRADITIONAL EXTRACTION</span>
      <span>|</span>
      <span>PURE GOODNESS</span>
    </div>
    <h1 class="p-hero-title">Pure Oils<br>for a Healthier<br>Tomorrow</h1>
    <p class="p-hero-desc">
      Cold pressed. Chemical free. Naturally nutritious. Bringing you the true essence of nature's finest ingredients, just as it has been for generations.
    </p>
    <a href="#our-oils" class="p-cta-btn">
      <span>EXPLORE OUR OILS</span>
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</section>

<style>
.p-hero-exact {
  position: relative;
  width: 100%;
  min-height: 85vh;
  display: flex;
  align-items: center;
  padding: 4rem 8%;
  background-color: #FAF5EB;
  background-image: 
    linear-gradient(
      to bottom,
      rgba(250, 245, 235, 0) 0%,
      rgba(250, 245, 235, 0) 60%,
      rgba(250, 245, 235, 0.35) 78%,
      rgba(250, 245, 235, 0.75) 88%,
      #FAF5EB 100%
    ),
    linear-gradient(
      90deg,
      rgba(250, 245, 235, 0.88) 0%,
      rgba(250, 245, 235, 0.82) 25%,
      rgba(250, 245, 235, 0.60) 42%,
      rgba(250, 245, 235, 0.25) 58%,
      rgba(250, 245, 235, 0) 75%
    ),
    url("{{ 'hero-bg-high.png' | asset_url }}");
  background-size: cover;
  background-position: center right;
  background-repeat: no-repeat;
  overflow: hidden;
  box-sizing: border-box;
}

/* Floating Corner Leaf Sprigs */
.p-floating-leaf {
  position: absolute;
  pointer-events: none;
  z-index: 10;
  opacity: 0.95;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.p-leaf-top-left {
  top: 0;
  left: 0;
  width: clamp(70px, 9vw, 120px);
  height: auto;
}

.p-leaf-top-right {
  top: 0;
  right: 0;
  width: clamp(70px, 9vw, 120px);
  height: auto;
}

/* Feathered bottom edge to dissolve the image seamlessly into the next section */
.p-hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180px;
  background: linear-gradient(
    to bottom,
    rgba(250, 245, 235, 0) 0%,
    rgba(250, 245, 235, 0.08) 25%,
    rgba(250, 245, 235, 0.32) 50%,
    rgba(250, 245, 235, 0.70) 75%,
    rgba(250, 245, 235, 0.94) 92%,
    #FAF5EB 100%
  );
  pointer-events: none;
  z-index: 1;
}

.p-hero .purathana-container {
  position: relative;
  z-index: 2;
}

.p-hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 3rem;
  align-items: center;
}

.p-hero-copy {
  display: flex;
  flex-direction: column;
  z-index: 2;
}

.p-eyebrow {
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #28422D;
  margin-bottom: 1.25rem;
}

.p-hero-headline {
  font-family: 'Marcellus', Georgia, serif;
  font-size: clamp(2.8rem, 5.2vw, 4.5rem);
  line-height: 1.12;
  color: #24221E;
  margin: 0 0 1.35rem;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.p-hero-headline em {
  font-family: 'Italiana', serif;
  font-style: italic;
  color: #28422D;
}

.p-hero-lead {
  font-size: 1.08rem;
  line-height: 1.75;
  color: rgba(36, 34, 30, 0.86);
  margin: 0 0 2rem;
  max-width: 530px;
}

/* Specs Row */
.p-specs-row {
  display: grid;
  grid-template-columns: repeat(4, auto);
  gap: 1.5rem;
  margin-bottom: 2.25rem;
  padding: 1rem 1.25rem;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 12px;
  border: 1px solid rgba(40, 66, 45, 0.12);
  width: fit-content;
}

.p-spec-item {
  display: flex;
  flex-direction: column;
}

.p-spec-val {
  font-family: 'Marcellus', Georgia, serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: #28422D;
  line-height: 1.2;
}

.p-spec-label {
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(36, 34, 30, 0.7);
  margin-top: 0.2rem;
}

.p-btn-row {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
}

.p-btn-luxe {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  background: #28422D;
  color: #FAF5EB;
  padding: 1.05rem 2.4rem;
  border-radius: 9999px;
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 4px 16px rgba(40, 66, 45, 0.22);
}

.p-btn-luxe:hover {
  background: #1C3020;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(40, 66, 45, 0.3);
}

.p-btn-secondary {
  display: inline-flex;
  align-items: center;
  padding: 1rem 2rem;
  border-radius: 9999px;
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  border: 1.8px solid #28422D;
  color: #24221E;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(8px);
  transition: all 0.3s ease;
}

.p-btn-secondary:hover {
  background: #28422D;
  color: #FAF5EB;
  transform: translateY(-2px);
}

.p-hero-stage-spacer {
  min-height: 480px;
  pointer-events: none;
}

@media (max-width: 990px) {
  .p-hero {
    min-height: auto;
    padding: 3.5rem 0 24rem;
    background-image: 
      linear-gradient(
        180deg,
        rgba(250, 245, 235, 0.82) 0%,
        rgba(250, 245, 235, 0.70) 20%,
        rgba(250, 245, 235, 0.45) 42%,
        rgba(250, 245, 235, 0.18) 60%,
        rgba(250, 245, 235, 0.04) 75%,
        rgba(250, 245, 235, 0) 88%
      ),
      url("{{ 'purathana-hero-bg.jpg' | asset_url }}");
    background-position: 74% bottom;
    background-size: cover;
  }

  .p-hero-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .p-hero-stage-spacer {
    display: none;
  }

  .p-specs-row {
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
    gap: 1rem;
  }
}

@media (max-width: 640px) {
  .p-hero {
    padding: 3rem 0 22rem;
  }
  .p-hero-headline {
    font-size: clamp(2.15rem, 8vw, 2.9rem);
    margin-bottom: 1.15rem;
  }
  .p-hero-lead {
    font-size: 0.98rem;
    line-height: 1.65;
    margin-bottom: 1.65rem;
  }
  .p-btn-row {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 0.85rem;
  }
  .p-btn-luxe,
  .p-btn-secondary {
    width: 100%;
    justify-content: center;
    text-align: center;
    padding: 0.95rem 1.5rem;
  }
  .p-specs-row {
    padding: 0.85rem 1rem;
    gap: 0.85rem;
  }
  .p-spec-val {
    font-size: 1.05rem;
  }
  .p-hero::after {
    height: 120px;
  }
}
</style>

{% schema %}
{
  "name": "Purathana Hero Luxury",
  "settings": [],
  "presets": [
    {
      "name": "Purathana Hero Luxury"
    }
  ]
}
{% endschema %}
