<!-- ===================================================================
     PURATHANA SPECIFICATION MATRIX: REFINED VS TRADITIONAL WOOD PRESSED
     Apple-style side-by-side architectural comparison.
     Radical clarity, scientific rigor, zero marketing fluff.
     =================================================================== -->

<section class="p-comparison-section" id="comparison">
  <div class="purathana-container">
    <div class="p-section-heading">
      <div class="p-eyebrow">The Standard of Purity</div>
      <h2 class="p-section-title">Factory Refining vs. The Living Press.</h2>
      <p class="p-section-sub">
        A direct technical comparison of modern industrial processing versus traditional low-speed cold extraction.
      </p>
    </div>

    <div class="p-matrix-table-wrap">
      <div class="p-matrix-table">
        <!-- Header Row -->
        <div class="p-matrix-row p-matrix-header">
          <div class="p-matrix-col p-col-metric">Metric</div>
          <div class="p-matrix-col p-col-commercial">Commercial Refined Oils</div>
          <div class="p-matrix-col p-col-purathana">Purathana Cold Pressed</div>
        </div>

        <!-- Row 1: Extraction -->
        <div class="p-matrix-row">
          <div class="p-matrix-col p-col-metric">
            <strong>Extraction</strong>
            <span>Solvent vs. Mechanical</span>
          </div>
          <div class="p-matrix-col p-col-commercial">
            <span class="p-matrix-bad"><span class="p-status-mark bad">✕</span> Chemical Hexane Bath</span>
          </div>
          <div class="p-matrix-col p-col-purathana">
            <span class="p-matrix-good"><span class="p-status-mark good">✓</span> 100% Vaagai Wood Mechanical</span>
          </div>
        </div>

        <!-- Row 2: Temperature -->
        <div class="p-matrix-row">
          <div class="p-matrix-col p-col-metric">
            <strong>Friction Heat</strong>
            <span>Lipid stability threshold</span>
          </div>
          <div class="p-matrix-col p-col-commercial">
            <span class="p-matrix-bad"><span class="p-status-mark bad">✕</span> 240°C Thermal Breakdown</span>
          </div>
          <div class="p-matrix-col p-col-purathana">
            <span class="p-matrix-good"><span class="p-status-mark good">✓</span> &lt; 38°C Body-Temp Living</span>
          </div>
        </div>

        <!-- Row 3: Clarification -->
        <div class="p-matrix-row">
          <div class="p-matrix-col p-col-metric">
            <strong>Clarification</strong>
            <span>Particulate filtration</span>
          </div>
          <div class="p-matrix-col p-col-commercial">
            <span class="p-matrix-bad"><span class="p-status-mark bad">✕</span> Acid Wash &amp; Bleaching Clays</span>
          </div>
          <div class="p-matrix-col p-col-purathana">
            <span class="p-matrix-good"><span class="p-status-mark good">✓</span> 7-Day Natural Gravity Rest</span>
          </div>
        </div>

        <!-- Row 4: Chemical Additives -->
        <div class="p-matrix-row">
          <div class="p-matrix-col p-col-metric">
            <strong>Chemicals</strong>
            <span>Preservatives &amp; blending</span>
          </div>
          <div class="p-matrix-col p-col-commercial">
            <span class="p-matrix-bad"><span class="p-status-mark bad">✕</span> TBHQ Preservatives &amp; Silicones</span>
          </div>
          <div class="p-matrix-col p-col-purathana">
            <span class="p-matrix-good"><span class="p-status-mark good">✓</span> 0.00% Chemicals · 100% Raw Virgin</span>
          </div>
        </div>

        <!-- Row 5: Freshness & Storage -->
        <div class="p-matrix-row">
          <div class="p-matrix-col p-col-metric">
            <strong>Freshness</strong>
            <span>Batch age &amp; storage</span>
          </div>
          <div class="p-matrix-col p-col-commercial">
            <span class="p-matrix-bad"><span class="p-status-mark bad">✕</span> 6–18 Month Warehouse Aged</span>
          </div>
          <div class="p-matrix-col p-col-purathana">
            <span class="p-matrix-good"><span class="p-status-mark good">✓</span> Fresh Weekly Batches · 0 Old Stock</span>
          </div>
        </div>
      </div>
    </div>
    <div class="p-matrix-mobile-hint">Swipe horizontally to compare columns &rarr;</div>
  </div>
</section>

<style>
.p-matrix-mobile-hint {
  display: none;
  text-align: center;
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.75rem;
  color: rgba(36, 34, 30, 0.6);
  margin-top: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.05em;
}

@media (max-width: 768px) {
  .p-comparison-section {
    padding: 2.75rem 0 !important;
    overflow: hidden !important;
  }
  .p-comparison-section .p-section-heading {
    margin-bottom: 1.25rem !important;
  }
  .p-comparison-section .p-section-title {
    font-size: 1.75rem !important;
    line-height: 1.2 !important;
  }
  .p-comparison-section .p-section-sub {
    font-size: 0.85rem !important;
    line-height: 1.45 !important;
  }
  .p-matrix-table-wrap {
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    border-radius: 12px !important;
    box-shadow: 0 4px 16px rgba(36, 34, 30, 0.05) !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }
  .p-matrix-table {
    min-width: 520px !important;
  }
  .p-matrix-col {
    padding: 0.85rem 0.95rem !important;
    font-size: 0.82rem !important;
  }
  .p-matrix-mobile-hint {
    display: block;
    margin-top: 0.65rem !important;
    font-size: 0.72rem !important;
  }
}
</style>

