let currentModalOil = null;
let currentModalVariantId = null;

// Open Interactive Product Inspection Modal
function openProductModal(oilKey) {
  const data = window.PURATHANA_CATALOG_DATA[oilKey];
  if (!data) return;
  currentModalOil = oilKey;

  const backdrop = document.getElementById('p-product-modal-backdrop');
  const titleEl = document.getElementById('p-modal-title');
  const taglineEl = document.getElementById('p-modal-tagline');
  const tastingEl = document.getElementById('p-modal-tasting');
  const frontImg = document.getElementById('p-modal-bottle-front');
  const backImg = document.getElementById('p-modal-bottle-back');
  const flipText = document.getElementById('p-modal-flip-text');
  const pillsRow = document.getElementById('p-modal-pills-row');
  const priceEl = document.getElementById('p-modal-price');
  const activeLabel = document.getElementById('p-modal-active-label');

  if (titleEl) titleEl.textContent = data.title;
  if (taglineEl) taglineEl.textContent = data.tagline;
  if (tastingEl) tastingEl.textContent = data.tasting;
  
  // Set default images
  if (frontImg) {
    frontImg.src = data.halfImg;
    frontImg.style.display = 'block';
  }
  if (backImg) {
    backImg.src = data.backImg;
    backImg.style.display = 'none';
  }
  if (flipText) flipText.textContent = 'View Nutritional Facts';

  // Populate Variant Pills
  if (pillsRow) {
    pillsRow.innerHTML = '';
    data.variants.forEach((v, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'p-modal-pill' + (idx === 0 ? ' active' : '') + (v.isCanister ? ' is-canister' : '');
      btn.dataset.variantId = v.id;
      btn.dataset.price = v.price;
      btn.dataset.isHalf = v.isHalf ? 'true' : 'false';
      btn.dataset.vtitle = v.title;
      
      btn.innerHTML = `
        <span class="p-modal-pill-name">${v.title}</span>
        <span class="p-modal-pill-price">${v.price}</span>
        ${v.isCanister ? '<span class="p-modal-canister-badge">BEST VALUE</span>' : ''}
      `;
      btn.onclick = function() { onModalPillSelect(btn, data); };
      pillsRow.appendChild(btn);

      if (idx === 0) {
        currentModalVariantId = v.id;
        if (priceEl) priceEl.textContent = v.price;
        if (activeLabel) activeLabel.textContent = v.title;
      }
    });
  }

  if (backdrop) {
    backdrop.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
}

function closeProductModal() {
  const backdrop = document.getElementById('p-product-modal-backdrop');
  if (backdrop) {
    backdrop.classList.remove('active');
    document.body.style.overflow = '';
  }
}

// Select Modal Variant Pill
function onModalPillSelect(btn, data) {
  const pillsRow = document.getElementById('p-modal-pills-row');
  if (pillsRow) {
    pillsRow.querySelectorAll('.p-modal-pill').forEach(p => p.classList.remove('active'));
  }
  btn.classList.add('active');

  currentModalVariantId = btn.dataset.variantId;
  const priceEl = document.getElementById('p-modal-price');
  const activeLabel = document.getElementById('p-modal-active-label');
  const frontImg = document.getElementById('p-modal-bottle-front');

  if (priceEl) priceEl.textContent = btn.dataset.price;
  if (activeLabel) activeLabel.textContent = btn.dataset.vtitle;

  // Swap front image between 500ml and 1L bottle
  if (frontImg) {
    if (btn.dataset.isHalf === 'true') {
      frontImg.src = data.halfImg;
    } else {
      frontImg.src = data.frontImg;
    }
  }
}

// Toggle Front/Back Bottle Label in Modal
function toggleModalBottleLabel() {
  const front = document.getElementById('p-modal-bottle-front');
  const back = document.getElementById('p-modal-bottle-back');
  const flipText = document.getElementById('p-modal-flip-text');
  if (!front || !back) return;

  if (front.style.display === 'none') {
    front.style.display = 'block';
    back.style.display = 'none';
    if (flipText) flipText.textContent = 'View Nutritional Facts';
  } else {
    front.style.display = 'none';
    back.style.display = 'block';
    if (flipText) flipText.textContent = 'View Front Bottle';
  }
}

// Add Modal Variant To Bag via AJAX
function addModalVariantToBag() {
  if (!currentModalVariantId) return;
  const addBtn = document.getElementById('p-modal-add-btn');
  const addText = document.getElementById('p-modal-add-text');
  if (!addBtn) return;

  const origText = addText ? addText.textContent : 'Add to Bag';
  if (addText) addText.textContent = 'Adding...';
  addBtn.disabled = true;

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: currentModalVariantId, quantity: 1 })
  })
  .then(res => res.json())
  .then(data => {
    if (addText) addText.textContent = 'Added to Bag ✓';
    setTimeout(() => {
      if (addText) addText.textContent = origText;
      addBtn.disabled = false;
      closeProductModal();
    }, 900);
    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
  })
  .catch(err => {
    console.error('Add to bag error:', err);
    if (addText) addText.textContent = origText;
    addBtn.disabled = false;
  });
}

// Scroll directly to the Monument stage for this oil
function scrollToOilStage() {
  closeProductModal();
  if (!currentModalOil) return;
  const data = window.PURATHANA_CATALOG_DATA[currentModalOil];
  if (!data) return;
  const stage = document.querySelector(`.p-monument-stage[data-oil-handle="${data.handle}"]`);
  if (stage) {
    stage.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
}

// Monument Stage Logic (Scroll Reveals, 3D Tilt, Live Variant Selection)
function initScrollReveals() {
  const stages = document.querySelectorAll('.p-monument-stage');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    stages.forEach(st => observer.observe(st));
  } else {
    stages.forEach(st => st.classList.add('is-revealed'));
  }
}

function initMonument3DTilt() {
  const pedestals = document.querySelectorAll('.p-monument-pedestal');
  pedestals.forEach(ped => {
    if (ped.dataset.tiltReady) return;
    ped.dataset.tiltReady = 'true';

    const bottleWrap = ped.querySelector('.p-monument-bottle-wrap');
    if (!bottleWrap) return;

    let rotX = 0, rotY = 0, targetX = 0, targetY = 0;
    let isTracking = false, rafId = null;

    function loop() {
      rotX += (targetX - rotX) * 0.14;
      rotY += (targetY - rotY) * 0.14;
      bottleWrap.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) scale3d(1.025, 1.025, 1.025)`;
      const diff = Math.abs(targetX - rotX) + Math.abs(targetY - rotY);
      if (isTracking || diff > 0.01) {
        rafId = requestAnimationFrame(loop);
      } else {
        rafId = null;
        if (!isTracking) {
          bottleWrap.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }
      }
    }

    function updateCoords(clientX, clientY) {
      const rect = ped.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;
      const midX = rect.width / 2;
      const midY = rect.height / 2;
      targetX = ((y - midY) / midY) * -12;
      targetY = ((x - midX) / midX) * 12;
      ped.style.setProperty('--mouse-x', `${x}px`);
      ped.style.setProperty('--mouse-y', `${y}px`);
      if (!rafId) rafId = requestAnimationFrame(loop);
    }

    ped.addEventListener('mouseenter', () => { isTracking = true; if (!rafId) rafId = requestAnimationFrame(loop); });
    ped.addEventListener('mousemove', e => { isTracking = true; updateCoords(e.clientX, e.clientY); });
    ped.addEventListener('mouseleave', () => { isTracking = false; targetX = 0; targetY = 0; if (!rafId) rafId = requestAnimationFrame(loop); });
  });
}

function toggleBottleLabel(productId) {
  const front = document.getElementById('img-front-' + productId);
  const back = document.getElementById('img-back-' + productId);
  const btnText = document.getElementById('flip-btn-text-' + productId);
  if (!front || !back) return;
  if (front.style.display === 'none') {
    front.style.display = 'block';
    back.style.display = 'none';
    if (btnText) btnText.textContent = 'View Nutritional Facts';
  } else {
    front.style.display = 'none';
    back.style.display = 'block';
    if (btnText) btnText.textContent = 'View Front Bottle';
  }
}

function onMonumentPillSelect(btn) {
  const productId = btn.dataset.productId;
  const variantId = btn.dataset.variantId;
  const priceFormatted = btn.dataset.price;
  const imgSrc = btn.dataset.imgSrc;
  const stage = document.getElementById('product-stage-' + productId);
  if (!stage) return;

  stage.querySelectorAll('.p-monument-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');

  const priceEl = document.getElementById('monument_price_' + productId);
  if (priceEl) priceEl.textContent = priceFormatted;

  const addBtn = document.getElementById('btn_monument_add_' + productId);
  if (addBtn) addBtn.dataset.activeVariantId = variantId;

  if (imgSrc) {
    const frontImg = document.getElementById('img-front-' + productId);
    if (frontImg) frontImg.src = imgSrc;
  }
}

function addMonumentVariantToBag(productId) {
  const stage = document.getElementById('product-stage-' + productId);
  if (!stage) return;
  const activePill = stage.querySelector('.p-monument-pill.active');
  const variantId = activePill ? activePill.dataset.variantId : null;
  const btn = document.getElementById('btn_monument_add_' + productId);
  if (!variantId || !btn) return;

  const origHtml = btn.innerHTML;
  btn.innerHTML = '<span>Adding...</span>';
  btn.disabled = true;

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(res => res.json())
  .then(data => {
    btn.innerHTML = '<span>Added ✓</span>';
    setTimeout(() => {
      btn.innerHTML = origHtml;
      btn.disabled = false;
    }, 1200);
    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
  })
  .catch(err => {
    console.error('Add to bag error:', err);
    btn.innerHTML = origHtml;
    btn.disabled = false;
  });
}

document.addEventListener('DOMContentLoaded', () => {
  initScrollReveals();
  initMonument3DTilt();
});
if (document.readyState === 'complete' || document.readyState === 'interactive') {
  setTimeout(() => {
    initScrollReveals();
    initMonument3DTilt();
  }, 100);
}
</script>

