<!-- ===================================================================
     PURATHANA NATURE'S BEST, BOTTLED FOR YOU
     1:1 Mockup Replication: 5 Pastel Ingredient Cards + Vintage Etchings
     Interactive Tap-In Product Inspection Modal & Monumental Showcase Stages
     =================================================================== -->

<section class="p-catalog-section" id="our-oils">
  <!-- Mockup Flanking Botanical Leaf Branches -->
  <img src="{{ 'leaf-branch-side.png' | asset_url }}" 
       alt="" 
       class="p-nature-accent p-nature-branch-tl" 
       style="top:-10px; left:-15px; width:170px; opacity:0.85; z-index:3;" 
       aria-hidden="true" />
  <img src="{{ 'leaf-branch-side.png' | asset_url }}" 
       alt="" 
       class="p-nature-accent p-nature-branch-tr" 
       style="top:-10px; right:-15px; width:170px; opacity:0.85; z-index:3;" 
       aria-hidden="true" />

  <div class="purathana-container">
    <!-- Section Header matching mockup 1:1 -->
    <div class="p-section-heading">
      <div class="p-leaf-motif">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#28422D" stroke-width="1.6">
          <path d="M12 2C6.5 2 2 6.5 2 12c0 3.5 1.8 6.6 4.5 8.4C7.8 17 10 13 14 10c0 0-2 6-1 9.9 5-1.1 9-5.6 9-11.9 0-3.3-2.7-6-6-6z"/>
        </svg>
      </div>
      <div class="p-eyebrow">OUR OILS</div>
      <h2 class="p-section-title">Nature's Best, Bottled for You</h2>
      <p class="p-section-sub">
        Cold pressed goodness for your everyday cooking. Real seeds, cold crushed in traditional botanical mortars.
      </p>
    </div>

    <!-- ===================================================================
         THE 5 MOCKUP PASTEL INGREDIENT CARDS (Real Ingredients & Vintage Etchings)
         =================================================================== -->
    <div class="p-mockup-cards-wrap">
      <div class="p-mockup-cards-grid">
        
        <!-- CARD 1: Groundnut Oil -->
        {% assign p_groundnut = all_products['cold-pressed-groundnut-oil'] %}
        <div class="p-mock-card p-mock-card-groundnut" 
             onclick="openProductModal('groundnut')"
             data-oil-key="groundnut"
             role="button"
             tabindex="0"
             aria-label="View Cold Pressed Groundnut Oil details and options">
          <div class="p-mock-card-header">
            <h3 class="p-mock-card-title">Groundnut Oil</h3>
            <p class="p-mock-card-tagline">Rich in taste, full of goodness.</p>
          </div>
          <div class="p-mock-card-dish-wrap">
            <img src="{{ 'purathana-dish-groundnut.png' | asset_url }}" 
                 alt="Real raw groundnuts and pure cold pressed oil bowl" 
                 class="p-mock-card-dish-img" 
                 loading="lazy" />
          </div>
          <div class="p-mock-card-btn-wrap">
            <button type="button" class="p-mock-shop-btn" onclick="event.stopPropagation(); openProductModal('groundnut');">
              <span>SHOP NOW</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          <div class="p-mock-card-etching-wrap">
            <img src="{{ 'purathana-etching-groundnut.png' | asset_url }}" 
                 alt="" 
                 class="p-mock-card-etching-img" 
                 loading="lazy" 
                 aria-hidden="true" />
          </div>
        </div>

        <!-- CARD 2: Mustard Oil -->
        {% assign p_mustard = all_products['cold-pressed-mustard-oil'] %}
        <div class="p-mock-card p-mock-card-mustard" 
             onclick="openProductModal('mustard')"
             data-oil-key="mustard"
             role="button"
             tabindex="0"
             aria-label="View Cold Pressed Mustard Oil details and options">
          <div class="p-mock-card-header">
            <h3 class="p-mock-card-title">Mustard Oil</h3>
            <p class="p-mock-card-tagline">Bold flavour, stronger health.</p>
          </div>
          <div class="p-mock-card-dish-wrap">
            <img src="{{ 'purathana-dish-mustard.png' | asset_url }}" 
                 alt="Real mustard seeds and yellow mustard blossom dish" 
                 class="p-mock-card-dish-img" 
                 loading="lazy" />
          </div>
          <div class="p-mock-card-btn-wrap">
            <button type="button" class="p-mock-shop-btn" onclick="event.stopPropagation(); openProductModal('mustard');">
              <span>SHOP NOW</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          <div class="p-mock-card-etching-wrap">
            <img src="{{ 'purathana-etching-mustard.png' | asset_url }}" 
                 alt="" 
                 class="p-mock-card-etching-img" 
                 loading="lazy" 
                 aria-hidden="true" />
          </div>
        </div>

        <!-- CARD 3: Coconut Oil -->
        {% assign p_coconut = all_products['cold-pressed-coconut-oil'] %}
        <div class="p-mock-card p-mock-card-coconut" 
             onclick="openProductModal('coconut')"
             data-oil-key="coconut"
             role="button"
             tabindex="0"
             aria-label="View Cold Pressed Coconut Oil details and options">
          <div class="p-mock-card-header">
            <h3 class="p-mock-card-title">Coconut Oil</h3>
            <p class="p-mock-card-tagline">Pure by nature, perfect for you.</p>
          </div>
          <div class="p-mock-card-dish-wrap">
            <img src="{{ 'purathana-dish-coconut.png' | asset_url }}" 
                 alt="Real cracked coconut copra and cold pressed coconut oil" 
                 class="p-mock-card-dish-img" 
                 loading="lazy" />
          </div>
          <div class="p-mock-card-btn-wrap">
            <button type="button" class="p-mock-shop-btn" onclick="event.stopPropagation(); openProductModal('coconut');">
              <span>SHOP NOW</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          <div class="p-mock-card-etching-wrap">
            <img src="{{ 'purathana-etching-coconut.png' | asset_url }}" 
                 alt="" 
                 class="p-mock-card-etching-img" 
                 loading="lazy" 
                 aria-hidden="true" />
          </div>
        </div>

        <!-- CARD 4: Sesame Oil -->
        {% assign p_sesame = all_products['cold-pressed-sesame-oil-gingelly'] %}
        <div class="p-mock-card p-mock-card-sesame" 
             onclick="openProductModal('sesame')"
             data-oil-key="sesame"
             role="button"
             tabindex="0"
             aria-label="View Cold Pressed Sesame Oil details and options">
          <div class="p-mock-card-header">
            <h3 class="p-mock-card-title">Sesame Oil</h3>
            <p class="p-mock-card-tagline">Small seeds, big benefits.</p>
          </div>
          <div class="p-mock-card-dish-wrap">
            <img src="{{ 'purathana-dish-sesame.png' | asset_url }}" 
                 alt="Heirloom black and white sesame seeds with golden oil dish" 
                 class="p-mock-card-dish-img" 
                 loading="lazy" />
          </div>
          <div class="p-mock-card-btn-wrap">
            <button type="button" class="p-mock-shop-btn" onclick="event.stopPropagation(); openProductModal('sesame');">
              <span>SHOP NOW</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          <div class="p-mock-card-etching-wrap">
            <img src="{{ 'purathana-etching-sesame.png' | asset_url }}" 
                 alt="" 
                 class="p-mock-card-etching-img" 
                 loading="lazy" 
                 aria-hidden="true" />
          </div>
        </div>

        <!-- CARD 5: Sunflower Oil -->
        {% assign p_sunflower = all_products['cold-pressed-sunflower-oil'] %}
        <div class="p-mock-card p-mock-card-sunflower" 
             onclick="openProductModal('sunflower')"
             data-oil-key="sunflower"
             role="button"
             tabindex="0"
             aria-label="View Cold Pressed Sunflower Oil details and options">
          <div class="p-mock-card-header">
            <h3 class="p-mock-card-title">Sunflower Oil</h3>
            <p class="p-mock-card-tagline">Light, healthy, heart friendly.</p>
          </div>
          <div class="p-mock-card-dish-wrap">
            <img src="{{ 'purathana-dish-sunflower.png' | asset_url }}" 
                 alt="Fresh sunflower blossom and seed bowl with golden oil" 
                 class="p-mock-card-dish-img" 
                 loading="lazy" />
          </div>
          <div class="p-mock-card-btn-wrap">
            <button type="button" class="p-mock-shop-btn" onclick="event.stopPropagation(); openProductModal('sunflower');">
              <span>SHOP NOW</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          <div class="p-mock-card-etching-wrap">
            <img src="{{ 'purathana-etching-sunflower.png' | asset_url }}" 
                 alt="" 
                 class="p-mock-card-etching-img" 
                 loading="lazy" 
                 aria-hidden="true" />
          </div>
        </div>

      </div>
    </div>

    <!-- ===================================================================
         INTERACTIVE TAP-IN PRODUCT MODAL
         Triggered whenever any card or SHOP NOW is tapped
         =================================================================== -->
    <div class="p-product-modal-backdrop" id="p-product-modal-backdrop" onclick="closeProductModal()">
      <div class="p-product-modal-content" onclick="event.stopPropagation()">
        <button type="button" class="p-modal-close-btn" onclick="closeProductModal()" aria-label="Close product view">
          ✕
        </button>

        <div class="p-modal-grid">
          <!-- Left: Half-Litre Bottle Photo & Nutrition Label Flip -->
          <div class="p-modal-media-col">
            <div class="p-modal-badge-row">
              <span class="p-modal-tag" id="p-modal-tag">100% PURE &amp; NATURAL</span>
            </div>
            <div class="p-modal-bottle-container" id="p-modal-bottle-container">
              <img id="p-modal-bottle-front" src="{{ 'purathana-half-groundnut.jpg' | asset_url }}" alt="Purathana Cold Pressed Oil Bottle" class="p-modal-bottle-img" />
              <img id="p-modal-bottle-back" src="{{ 'purathana-groundnut-back.jpg' | asset_url }}" alt="Nutrition Facts" class="p-modal-bottle-img" style="display:none;" />
            </div>
            <div class="p-modal-flip-action">
              <button type="button" class="p-modal-flip-btn" onclick="toggleModalBottleLabel()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span id="p-modal-flip-text">View Nutritional Facts</span>
              </button>
            </div>
          </div>

          <!-- Right: Product Selection & Instant Add to Bag -->
          <div class="p-modal-info-col">
            <div class="p-modal-header">
              <span class="p-modal-step">COLD PRESSED EXTRACTION</span>
              <h3 class="p-modal-title" id="p-modal-title">Cold Pressed Groundnut Oil</h3>
              <p class="p-modal-tagline" id="p-modal-tagline">Rich in taste, full of goodness.</p>
              <p class="p-modal-tasting" id="p-modal-tasting">Golden Amber Hue · Roasted Nutty Fragrance · 230°C Smoke Point</p>
            </div>

            <!-- Volume & Pack Selector -->
            <div class="p-modal-variants-section">
              <div class="p-modal-var-heading">
                <span>SELECT VOLUME &amp; PACKAGING:</span>
                <span class="p-modal-active-label" id="p-modal-active-label">Half Litre Bottle (500ml)</span>
              </div>
              <div class="p-modal-pills-row" id="p-modal-pills-row">
                <!-- Dynamically populated per selected oil -->
              </div>
            </div>

            <!-- Unit Economics & Add to Bag -->
            <div class="p-modal-action-row">
              <div class="p-modal-price-box">
                <div class="p-modal-price" id="p-modal-price">₹195.00</div>
                <div class="p-modal-tax-note">Tax Included · Free Dispatch on ₹799+</div>
              </div>
              <button type="button" class="p-modal-add-btn" id="p-modal-add-btn" onclick="addModalVariantToBag()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span id="p-modal-add-text">Add to Bag</span>
              </button>
            </div>

            <!-- Quality & Purity Chips -->
            <div class="p-modal-chips-grid">
              <div class="p-modal-chip">
                <strong>Vaagai Wood</strong>
                <span>Mortar crushed</span>
              </div>
              <div class="p-modal-chip">
                <strong>&lt; 38°C Cold</strong>
                <span>Enzymes active</span>
              </div>
              <div class="p-modal-chip">
                <strong>0.00 PPM Hexane</strong>
                <span>Zero chemicals</span>
              </div>
              <div class="p-modal-chip">
                <strong>Weekly Batch</strong>
                <span>Direct farm fresh</span>
              </div>
            </div>

            <!-- Full Stage Scroll / Deep Dive Link -->
            <div class="p-modal-footer-nav">
              <a href="javascript:void(0)" class="p-modal-deepdive-link" onclick="scrollToOilStage()">
                <span>Scroll to Complete Detailed Specifications</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <polyline points="19 12 12 19 5 12"></polyline>
                </svg>
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- ===================================================================
         MONUMENTAL PRODUCT SHOWCASE LIST (Deep-Dive Cutout Bottle Stages)
         =================================================================== -->
    <div class="p-monument-list" id="monumental-stages">
      {% assign oil_collection = collections['cold-pressed-oils'] %}
      {% if oil_collection == blank or oil_collection.products.size == 0 %}
        {% assign oil_collection = collections['all'] %}
      {% endif %}

      {% if oil_collection and oil_collection.products.size > 0 %}
        {% for product in oil_collection.products %}
          {% assign clean_img = product.featured_image | image_url: width: 800 %}
          {% assign half_img = product.featured_image | image_url: width: 800 %}
          {% assign t_lower = product.title | downcase %}
          {% assign oil_theme = 'peanut' %}
          {% assign tasting_notes = 'Golden Amber Hue · Roasted Nutty Fragrance · 230°C Smoke Point' %}
          {% assign origin_story = 'Slow-crushed from select Saurashtra peanuts in traditional botanical Vaagai mortars. Retains natural phytosterols, heart-healthy MUFA, and deep traditional aroma.' %}
          {% assign smoke_point = '230°C High Heat' %}
          {% assign fatty_profile = 'Rich in MUFA & Resveratrol' %}

          {% if t_lower contains 'sunflower' %}
            {% assign clean_img = 'purathana-sunflower-front.jpg' | asset_url %}
            {% assign half_img = 'purathana-half-sunflower.png' | asset_url %}
            {% assign back_img = 'purathana-sunflower-back.jpg' | asset_url %}
            {% assign oil_theme = 'sunflower' %}
            {% assign card_tagline = 'Light, healthy, heart friendly.' %}
            {% assign tasting_notes = 'Bright Sunlit Gold · Delicate Crisp Finish · High Vitamin E' %}
            {% assign origin_story = 'Cold-pressed from select sun-drenched native sunflower seeds. Retains delicate natural aroma, high polyunsaturated fats (PUFA), and zero synthetic additives.' %}
            {% assign smoke_point = '225°C Sauté & Bake' %}
            {% assign fatty_profile = 'High PUFA & Tocopherols' %}
          {% elsif t_lower contains 'sesame' or t_lower contains 'gingelly' %}
            {% assign clean_img = 'purathana-sesame-front.jpg' | asset_url %}
            {% assign half_img = 'purathana-half-sesame.png' | asset_url %}
            {% assign back_img = 'purathana-sesame-back.jpg' | asset_url %}
            {% assign oil_theme = 'sesame' %}
            {% assign card_tagline = 'Small seeds, big benefits.' %}
            {% assign tasting_notes = 'Deep Ruby-Amber · Toasted Earthy Depth · Traditional Palm Jaggery' %}
            {% assign origin_story = 'Crushed from indigenous black sesame seeds with authentic palm jaggery in traditional Vaagai mortars. The ancient superfood for modern living, rich in sesamol and zinc.' %}
            {% assign smoke_point = '210°C Deep Sauté' %}
            {% assign fatty_profile = 'Active Sesamol & Zinc' %}
          {% elsif t_lower contains 'coconut' %}
            {% assign clean_img = 'purathana-coconut-front.jpg' | asset_url %}
            {% assign half_img = 'purathana-half-coconut.png' | asset_url %}
            {% assign back_img = 'purathana-coconut-back.jpg' | asset_url %}
            {% assign oil_theme = 'coconut' %}
            {% assign card_tagline = 'Pure by nature, perfect for you.' %}
            {% assign tasting_notes = 'Silky Crystal Clarity · Sweet Copra Aroma · 62% Lauric Acid MCTs' %}
            {% assign origin_story = 'Extracted from natural sun-dried sulfur-free copra along coastal groves. Pure and natural for cooking, health & vitality, packed with active lauric acid.' %}
            {% assign smoke_point = '177°C Raw & Low Heat' %}
            {% assign fatty_profile = '62% Medium Chain MCTs' %}
          {% elsif t_lower contains 'groundnut' or t_lower contains 'peanut' %}
            {% assign clean_img = 'purathana-groundnut-front.jpg' | asset_url %}
            {% assign half_img = 'purathana-half-groundnut.jpg' | asset_url %}
            {% assign back_img = 'purathana-groundnut-back.jpg' | asset_url %}
            {% assign oil_theme = 'groundnut' %}
            {% assign card_tagline = 'Rich in taste, full of goodness.' %}
            {% assign tasting_notes = 'Golden Amber Hue · Roasted Nutty Fragrance · 230°C Smoke Point' %}
            {% assign origin_story = 'Slow-crushed from select Saurashtra peanuts in traditional botanical Vaagai mortars. Cold pressed goodness for everyday cooking, rich in natural phytosterols.' %}
            {% assign smoke_point = '230°C High Heat' %}
            {% assign fatty_profile = 'Heart-Healthy MUFA' %}
          {% elsif t_lower contains 'mustard' or t_lower contains 'musturd' %}
            {% assign clean_img = 'purathana-mustard-front.jpg' | asset_url %}
            {% assign half_img = 'purathana-half-mustard.png' | asset_url %}
            {% assign back_img = 'purathana-mustard-back.jpg' | asset_url %}
            {% assign oil_theme = 'mustard' %}
            {% assign card_tagline = 'Bold flavour, stronger health.' %}
            {% assign tasting_notes = 'Pungent Golden Kick · Rich Sinigrin & Allyl · Natural Antimicrobial' %}
            {% assign origin_story = 'Strong, pure, perfect for authentic flavour. Extracted from high-grade whole black mustard seeds in a pure mechanical press with zero chemical additives.' %}
            {% assign smoke_point = '250°C Highest Heat' %}
            {% assign fatty_profile = 'Allyl Isothiocyanate Active' %}
          {% endif %}

          <article class="p-monument-stage {% cycle 'p-layout-left', 'p-layout-right' %} theme-{{ oil_theme }}" 
                   id="product-stage-{{ product.id }}"
                   data-oil-handle="{{ product.handle }}"
                   data-product-id="{{ product.id }}">
            
            <div class="p-monument-inner">
              
              <!-- 50% Screen Width: The Monumental Cutout Bottle Stage -->
              <div class="p-monument-bottle-col">
                <div class="p-monument-pedestal" id="pedestal-{{ product.id }}">
                  <div class="p-monument-glow glow-{{ oil_theme }}"></div>
                  <div class="p-monument-specular-glare"></div>

                  <div class="p-monument-bottle-wrap" id="bottle-wrap-{{ product.id }}" onclick="toggleBottleLabel('{{ product.id }}')" style="cursor:pointer;" title="Click to view back label & nutrition facts">
                    <img src="{{ half_img }}" 
                         alt="{{ product.title | escape }}" 
                         class="p-monument-bottle-img" 
                         id="img-front-{{ product.id }}"
                         loading="lazy" />
                    <img src="{{ back_img }}" 
                         alt="{{ product.title | escape }} Nutritional Label" 
                         class="p-monument-bottle-img" 
                         id="img-back-{{ product.id }}"
                         style="display:none;" 
                         loading="lazy" />
                  </div>

                  <div class="p-monument-ground-shadow"></div>

                  <div class="p-monument-floating-stamp">
                    <span class="p-stamp-dot"></span>
                    <span>14 RPM VAAGAI MORTAR</span>
                  </div>

                  <button type="button" 
                          class="p-monument-flip-trigger" 
                          onclick="toggleBottleLabel('{{ product.id }}')"
                          title="View Nutritional Facts & Certification">
                    <span id="flip-btn-text-{{ product.id }}">View Nutritional Facts</span>
                  </button>
                </div>
              </div>

              <!-- 50% Screen Width: Scroll-Revealed Details -->
              <div class="p-monument-details-col">
                <div class="p-monument-details-box">
                  
                  <div class="p-monument-eyebrow-row">
                    <span class="p-monument-badge">RESERVE HARVEST · STEP 0{{ forloop.index }}</span>
                    <span class="p-monument-smoke-tag">{{ smoke_point }}</span>
                  </div>

                  <h3 class="p-monument-title">
                    {{ product.title }}
                  </h3>

                  <div class="p-monument-subheading-tagline">
                    {{ card_tagline }}
                  </div>

                  <div class="p-monument-tasting-banner">
                    <span class="p-tasting-pill">{{ tasting_notes }}</span>
                  </div>

                  <p class="p-monument-story">
                    {{ origin_story }}
                  </p>

                  <!-- Visual Purity Badges -->
                  <div class="p-monument-chips-grid">
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>Vaagai Wood</strong>
                        <span>Mortar crushed</span>
                      </div>
                    </div>
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>&lt; 38°C Cold</strong>
                        <span>Enzymes intact</span>
                      </div>
                    </div>
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>0.00 PPM Hexane</strong>
                        <span>Zero chemicals</span>
                      </div>
                    </div>
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>Fresh Weekly</strong>
                        <span>Zero aged stock</span>
                      </div>
                    </div>
                  </div>

                  <!-- Volume & Packaging Variant Selector -->
