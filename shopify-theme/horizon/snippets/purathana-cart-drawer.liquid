<!-- ===================================================================
     PURATHANA LUXURY BAG DRAWER (Shopify Liquid)
     Design Philosophy: Apple Bag Minimalist Precision
     Zero AI slop, zero cartoon emojis, razor-sharp architectural layout.
     Implements all SOW CRO Rules:
     - Dynamic Free Shipping Meter (Threshold ₹999)
     - Automatic 20% Volume Privilege (> ₹2,999)
     - Promotional Code Entry (e.g. FLAT10)
     - Loyalty Reward Credits (50 pts = ₹50)
     - Handcrafted Jute Gift Wrap (+₹50)
     =================================================================== -->

<div class="p-bag-overlay" id="PurathanaCartOverlay" onclick="closePurathanaBag()"></div>

<aside class="p-bag-drawer" id="PurathanaCartDrawer" aria-label="Review Your Bag" role="dialog" aria-modal="true">
  <!-- Header -->
  <div class="p-bag-header">
    <div class="p-bag-header-left">
      <span class="p-bag-eyebrow">The Reserve</span>
      <h2 class="p-bag-title">
        Review Your Bag
        <span class="p-bag-count" id="CartDrawerItemCount">({{ cart.item_count }})</span>
      </h2>
    </div>
    <button class="p-bag-close-btn" onclick="closePurathanaBag()" aria-label="Close Bag">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Dynamic Complimentary Express Dispatch Meter (Threshold ₹999) -->
  <div class="p-bag-dispatch-bar">
    {% assign threshold_cents = 99900 %}
    {% assign current_cents = cart.total_price %}
    {% assign remaining_cents = threshold_cents | minus: current_cents %}
    {% assign progress_pct = current_cents | times: 100 | divided_by: threshold_cents %}
    {% if progress_pct > 100 %}{% assign progress_pct = 100 %}{% endif %}

    <div class="p-dispatch-meta">
      <span class="p-dispatch-label">Express Dispatch</span>
      <span class="p-dispatch-status" id="FreeShippingText">
        {% if current_cents >= threshold_cents %}
          <span class="p-status-unlocked">Complimentary express dispatch unlocked</span>
        {% else %}
          <span>Add <strong>₹{{ remaining_cents | divided_by: 100 }}</strong> for complimentary dispatch</span>
        {% endif %}
      </span>
    </div>
    <div class="p-dispatch-track">
      <div class="p-dispatch-fill" id="FreeShippingBar" style="width: {{ progress_pct }}%;"></div>
    </div>
  </div>

  <!-- Automatic 20% Volume Privilege Banner (> ₹2,999) -->
  {% assign bulk_threshold_cents = 299900 %}
  <div class="p-bag-privilege-banner {% if current_cents >= bulk_threshold_cents %}active{% endif %}" id="CartBulkBanner">
    <div class="p-privilege-indicator">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
      </svg>
    </div>
    <div class="p-privilege-copy" id="CartBulkText">
      {% if current_cents >= bulk_threshold_cents %}
        <span><strong>Volume Privilege Applied:</strong> Flat 20% savings deducted at checkout.</span>
      {% else %}
        {% assign more_bulk = bulk_threshold_cents | minus: current_cents | divided_by: 100 %}
        <span>Add ₹{{ more_bulk }} to unlock the <strong>20% Volume Privilege</strong>.</span>
      {% endif %}
    </div>
  </div>

  <!-- Bag Items Scroll Area -->
  <div class="p-bag-items-scroll" id="CartItemsContainer">
    {% if cart.item_count == 0 %}
      <div class="p-bag-empty">
        <div class="p-empty-glyph">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <h3 class="p-empty-title">Your Bag is Empty</h3>
        <p class="p-empty-sub">Experience unrefined cold-pressed oils extracted at human friction.</p>
        <a href="#catalog" onclick="closePurathanaBag()" class="p-btn-luxe" style="margin-top:1.5rem; display:inline-flex;">
          Explore The Collection
        </a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="p-bag-item" data-line="{{ forloop.index }}">
          <div class="p-item-thumb">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}" loading="lazy" />
            {% endif %}
          </div>
          <div class="p-item-info">
            <div class="p-item-top">
              <h4 class="p-item-title">{{ item.product.title }}</h4>
              <div class="p-item-price">{{ item.final_line_price | money }}</div>
            </div>
            
            <div class="p-item-variant">{{ item.variant.title }}</div>

            <div class="p-item-actions">
              <div class="p-qty-stepper">
                <button type="button" class="p-stepper-btn" onclick="updateBagItemQty({{ forloop.index }}, {{ item.quantity | minus: 1 }})" aria-label="Decrease quantity">
                  −
                </button>
                <span class="p-stepper-val">{{ item.quantity }}</span>
                <button type="button" class="p-stepper-btn" onclick="updateBagItemQty({{ forloop.index }}, {{ item.quantity | plus: 1 }})" aria-label="Increase quantity">
                  +
                </button>
              </div>
              <button type="button" class="p-item-remove" onclick="updateBagItemQty({{ forloop.index }}, 0)">
                Remove
              </button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <!-- Footer & Financial Breakdown -->
  {% if cart.item_count > 0 %}
    <div class="p-bag-footer">
      <!-- Concierge Toggles -->
      <div class="p-bag-toggles">
        <label class="p-toggle-row">
          <input type="checkbox" id="ShopifyGiftWrapToggle" onchange="toggleGiftWrap(this.checked)" />
          <span class="p-toggle-box"></span>
          <span class="p-toggle-label">Handcrafted Jute Gift Packaging</span>
          <span class="p-toggle-meta">+₹50</span>
        </label>

        <label class="p-toggle-row">
          <input type="checkbox" id="ShopifyRewardPointsToggle" onchange="toggleRewardPoints(this.checked)" />
          <span class="p-toggle-box"></span>
          <span class="p-toggle-label">Redeem Vedic Loyalty Credits</span>
          <span class="p-toggle-meta" style="color:var(--p-color-brass);">50 pts (−₹50)</span>
        </label>
      </div>

      <!-- Promo Code Entry -->
      <div class="p-bag-coupon-row">
        <div class="p-coupon-field">
          <input type="text" id="ShopifyCouponInput" placeholder="Promotional Code (e.g. FLAT10)" autocomplete="off" />
          <button type="button" class="p-coupon-btn" onclick="applyPromoCode()">Apply</button>
        </div>
      </div>

      <!-- Financial Calculation Matrix -->
      <div class="p-bag-ledger">
        <div class="p-ledger-row">
          <span>Subtotal</span>
          <span id="p-subtotal-val">{{ cart.total_price | money }}</span>
        </div>
        <div class="p-ledger-row">
          <span>Estimated Delivery</span>
          <span id="p-shipping-val">
            {% if cart.total_price >= 99900 %}
              <span class="p-badge-complimentary">Complimentary</span>
            {% else %}
              ₹80
            {% endif %}
          </span>
        </div>
        <div class="p-ledger-row p-ledger-total">
          <span>Estimated Total</span>
          <span class="p-total-val" id="p-grandtotal-val">{{ cart.total_price | money }}</span>
        </div>
        <div class="p-tax-note">Inclusive of all applicable GST. Instant order tracking dispatched via SMS.</div>
      </div>

      <!-- Apple-Style Primary Checkout CTA -->
      <a href="/checkout" class="p-checkout-cta" id="pCheckoutBtn">
        <span>Proceed to Checkout</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      {% render 'purathana-trust-badges' %}
    </div>
  {% endif %}
</aside>

<script>
/* ===================================================================
   PURATHANA BAG SCRIPT (AJAX Cart Management)
   =================================================================== */
function openPurathanaBag() {
  const overlay = document.getElementById('PurathanaCartOverlay');
  const drawer = document.getElementById('PurathanaCartDrawer');
  if (overlay && drawer) {
    overlay.classList.add('active');
    drawer.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
}

function closePurathanaBag() {
  const overlay = document.getElementById('PurathanaCartOverlay');
  const drawer = document.getElementById('PurathanaCartDrawer');
  if (overlay && drawer) {
    overlay.classList.remove('active');
    drawer.classList.remove('active');
    document.body.style.overflow = '';
  }
}

// Intercept all native cart triggers in Horizon theme
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('[data-testid="cart-drawer-trigger"], .action__cart, a[href="/cart"]').forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      openPurathanaBag();
    });
  });
});

function updateBagItemQty(line, qty) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ line: line, quantity: qty })
  })
  .then(res => res.json())
  .then(() => {
    window.location.reload();
  })
  .catch(err => console.error('Cart update error:', err));
}

function applyPromoCode() {
  const code = document.getElementById('ShopifyCouponInput')?.value.trim();
  if (code) {
    window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=/checkout';
  }
}

function toggleGiftWrap(isChecked) {
  // Store gift wrap preference in note or cart attribute
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: { 'Handcrafted Jute Gift Packaging': isChecked ? 'Yes (+₹50)' : 'No' }
    })
  });
}

function toggleRewardPoints(isChecked) {
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: { 'Vedic Club Loyalty Credits': isChecked ? '50 Points Redeemed' : 'None' }
    })
  });
}
</script>
