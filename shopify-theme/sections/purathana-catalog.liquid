<!-- ===================================================================
     PURATHANA MONUMENTAL PRODUCT SHOWCASE
     Ultra-Premium Half-Screen Cutout Product Stages
     Scroll-Driven Detail Reveal · 3D Spring Tilt Physics · Instant Unit Economics
     =================================================================== -->

<section class="p-catalog-section" id="catalog">
  <div class="purathana-container">
    <div class="p-section-heading" style="text-align:center; margin-bottom:2.5rem;">
      <div class="p-eyebrow">The Living Reserve</div>
      <h2 class="p-section-title">Fresh Cold-Pressed Oils</h2>
      <p class="p-section-sub" style="max-width:620px; margin-inline:auto;">
        Select your oil, choose 1-Litre apothecary bottle or 5-Litre value canister (save up to ₹150), and add to bag. Fresh micro-batch dispatched direct.
      </p>
    </div>

    <!-- ===================================================================
         MONUMENTAL PRODUCT SHOWCASE LIST (Half-Screen Cutouts + Scroll Reveals)
         =================================================================== -->
    <div class="p-monument-list">
      {% assign oil_collection = collections['cold-pressed-oils'] %}
      {% if oil_collection == blank or oil_collection.products.size == 0 %}
        {% assign oil_collection = collections['all'] %}
      {% endif %}

      {% if oil_collection and oil_collection.products.size > 0 %}
        {% for product in oil_collection.products %}
          {% assign clean_img = product.featured_image | image_url: width: 800 %}
          {% assign t_lower = product.title | downcase %}
          {% assign oil_theme = 'peanut' %}
          {% assign tasting_notes = 'Golden Amber Hue · Roasted Nutty Fragrance · 230°C Smoke Point' %}
          {% assign origin_story = 'Slow-crushed from select Saurashtra peanuts in traditional botanical Vaagai mortars. Retains natural phytosterols, heart-healthy MUFA, and deep traditional aroma.' %}
          {% assign smoke_point = '230°C High Heat' %}
          {% assign fatty_profile = 'Rich in MUFA & Resveratrol' %}

          {% if t_lower contains 'sunflower' %}
            {% assign clean_img = 'sunflower.png' | asset_url %}
            {% assign oil_theme = 'sunflower' %}
            {% assign tasting_notes = 'Bright Sunlit Gold · Delicate Crisp Finish · High Vitamin E' %}
            {% assign origin_story = 'Cold-pressed from select sun-drenched native sunflower seeds. Retains delicate natural aroma, high polyunsaturated fats (PUFA), and zero synthetic TBHQ.' %}
            {% assign smoke_point = '225°C Sauté & Bake' %}
            {% assign fatty_profile = 'High PUFA & Tocopherols' %}
          {% elsif t_lower contains 'sesame' or t_lower contains 'gingelly' %}
            {% assign clean_img = 'sesame.png' | asset_url %}
            {% assign oil_theme = 'sesame' %}
            {% assign tasting_notes = 'Deep Ruby-Amber · Toasted Earthy Depth · Traditional Palm Jaggery' %}
            {% assign origin_story = 'Crushed from indigenous black sesame seeds with authentic palm jaggery in traditional Vaagai mortars. Ayurvedic living base rich in sesamol and natural zinc.' %}
            {% assign smoke_point = '210°C Deep Sauté' %}
            {% assign fatty_profile = 'Active Sesamol & Zinc' %}
          {% elsif t_lower contains 'coconut' %}
            {% assign clean_img = 'coconut.png' | asset_url %}
            {% assign oil_theme = 'coconut' %}
            {% assign tasting_notes = 'Silky Crystal Clarity · Sweet Copra Aroma · 62% Lauric Acid MCTs' %}
            {% assign origin_story = 'Extracted from natural sun-dried sulfur-free copra along coastal groves. Unbleached, unrefined, liquid at room temperature, packed with active lauric acid.' %}
            {% assign smoke_point = '177°C Raw & Low Heat' %}
            {% assign fatty_profile = '62% Medium Chain MCTs' %}
          {% elsif t_lower contains 'groundnut' or t_lower contains 'peanut' %}
            {% assign clean_img = 'peanut.png' | asset_url %}
            {% assign oil_theme = 'peanut' %}
            {% assign tasting_notes = 'Golden Amber Hue · Roasted Nutty Fragrance · 230°C Smoke Point' %}
            {% assign origin_story = 'Slow-crushed from select Saurashtra peanuts in traditional botanical Vaagai mortars. Retains natural phytosterols, heart-healthy MUFA, and deep traditional aroma.' %}
            {% assign smoke_point = '230°C High Heat' %}
            {% assign fatty_profile = 'Heart-Healthy MUFA' %}
          {% elsif t_lower contains 'mustard' or t_lower contains 'musturd' %}
            {% assign clean_img = 'musturd.png' | asset_url %}
            {% assign oil_theme = 'mustard' %}
            {% assign tasting_notes = 'Pungent Golden Kick · Rich Sinigrin & Allyl · Natural Antimicrobial' %}
            {% assign origin_story = 'Extracted from high-altitude black mustard seeds. Pure mechanical press with zero argemone adulteration, preserving authentic therapeutic pungency.' %}
            {% assign smoke_point = '250°C Highest Heat' %}
            {% assign fatty_profile = 'Allyl Isothiocyanate Active' %}
          {% endif %}

          <article class="p-monument-stage {% cycle 'p-layout-left', 'p-layout-right' %} theme-{{ oil_theme }}" 
                   id="product-stage-{{ product.id }}"
                   data-product-id="{{ product.id }}">
            
            <div class="p-monument-inner">
              
              <!-- 50% Screen Width: The Monumental Cutout Bottle Stage -->
              <div class="p-monument-bottle-col">
                <div class="p-monument-pedestal" id="pedestal-{{ product.id }}">
                  <!-- Radial Ambient Halo Glow -->
                  <div class="p-monument-glow glow-{{ oil_theme }}"></div>
                  
                  <!-- Dynamic Specular Glare Layer -->
                  <div class="p-monument-specular-glare"></div>

                  <!-- The Transparent Cutout Product Bottle (Covers ~Half Screen) -->
                  <div class="p-monument-bottle-wrap" onclick="window.location.href='{{ product.url }}'">
                    <img src="{{ clean_img }}" 
                         alt="{{ product.title | escape }}" 
                         class="p-monument-bottle-img" 
                         loading="lazy" />
                  </div>

                  <!-- Contact Shadow Beneath Bottle Base -->
                  <div class="p-monument-ground-shadow"></div>

                  <!-- Floating Botanical Extraction Stamp -->
                  <div class="p-monument-floating-stamp">
                    <span class="p-stamp-dot"></span>
                    <span>14 RPM VAAGAI MORTAR</span>
                  </div>

                  <!-- Quick 3D Flip Hint Button -->
                  <button type="button" 
                          class="p-monument-flip-trigger" 
                          onclick="toggleMonumentLabSpecs('{{ product.id }}')"
                          title="View Laboratory Certificate">
                    <span>3D Lab Analysis</span>
                  </button>
                </div>
              </div>

              <!-- 50% Screen Width: Scroll-Revealed Premium Details -->
              <div class="p-monument-details-col">
                <div class="p-monument-details-box">
                  
                  <!-- Eyebrow & Reserve Badge -->
                  <div class="p-monument-eyebrow-row">
                    <span class="p-monument-badge">RESERVE SELECTION · STEP 0{{ forloop.index }}</span>
                    <span class="p-monument-smoke-tag">{{ smoke_point }}</span>
                  </div>

                  <!-- Product Headline -->
                  <h3 class="p-monument-title" onclick="window.location.href='{{ product.url }}'">
                    {{ product.title }}
                  </h3>

                  <!-- Sensory Tasting Notes Banner -->
                  <div class="p-monument-tasting-banner">
                    <span class="p-tasting-pill">{{ tasting_notes }}</span>
                  </div>

                  <!-- Origin & Purity Narrative -->
                  <p class="p-monument-story">
                    {{ origin_story }}
                  </p>

                  <!-- Visual Purity Badges (Zero Dense Essays) -->
                  <div class="p-monument-chips-grid">
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>Vaagai Wood</strong>
                        <span>Friction absorbed</span>
                      </div>
                    </div>
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>&lt; 38°C Cold</strong>
                        <span>Enzymes intact</span>
                      </div>
                    </div>
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>0.00 PPM Hexane</strong>
                        <span>Pure mechanical press</span>
                      </div>
                    </div>
                    <div class="p-monument-chip">
                      <span class="p-chip-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg>
                      </span>
                      <div class="p-chip-text">
                        <strong>Fresh Weekly</strong>
                        <span>Zero aged storage</span>
                      </div>
                    </div>
                  </div>

                  <!-- Hardware Spec Variant Selector (Volume & Packaging) -->
                  <div class="p-monument-variant-wrap">
                    <div class="p-variant-label-row">
                      <span class="p-variant-label">SELECT VOLUME &amp; PACKAGING:</span>
                      <span class="p-variant-subtext">{{ fatty_profile }}</span>
                    </div>
                    <div class="p-monument-pills-row">
                      {% for variant in product.variants %}
                        {% assign v_title = variant.title %}
                        {% assign is_canister = false %}
                        {% if v_title contains '5L' or v_title contains '5 Litre' or v_title contains '5000' %}
                          {% assign is_canister = true %}
                        {% endif %}
                        <button type="button" 
                                class="p-monument-pill {% if forloop.first %}active{% endif %} {% if is_canister %}is-canister{% endif %}" 
                                data-product-id="{{ product.id }}"
                                data-variant-id="{{ variant.id }}"
                                data-price="{{ variant.price | money }}"
                                data-raw-price="{{ variant.price }}"
                                onclick="onMonumentPillSelect(this)">
                          <span class="p-pill-vname">{{ variant.title }}</span>
                          <span class="p-pill-vprice">{{ variant.price | money }}</span>
                          {% if is_canister %}
                            <span class="p-canister-badge">BEST VALUE</span>
                          {% endif %}
                        </button>
                      {% endfor %}
                    </div>
                  </div>

                  <!-- Footer Action Zone: Real-Time Price + Add to Bag -->
                  <div class="p-monument-action-bar">
                    <div class="p-monument-price-box">
                      <div class="p-monument-price" id="monument_price_{{ product.id }}">
                        {{ product.price | money }}
                      </div>
                      <div class="p-monument-tax-sub">Tax Included · Free Dispatch on ₹799+</div>
                    </div>

                    <div class="p-monument-btn-group">
                      <button type="button" 
                              class="p-monument-add-btn" 
                              id="btn_monument_add_{{ product.id }}"
                              onclick="addMonumentVariantToBag('{{ product.id }}')">
                        <span>Add to Bag</span>
                        <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                          <line x1="3" y1="6" x2="21" y2="6"></line>
                          <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                      </button>
                    </div>
                  </div>

                  <!-- Slide-in Lab Purity Specs Panel -->
                  <div class="p-monument-lab-drawer" id="lab-drawer-{{ product.id }}">
                    <div class="p-lab-drawer-top">
                      <div class="p-lab-badge">VERIFIED LABORATORY SPECS · BATCH #{{ product.id | slice: -4, 4 }}</div>
                      <button type="button" class="p-lab-close" onclick="toggleMonumentLabSpecs('{{ product.id }}')">✕</button>
                    </div>
                    <div class="p-lab-grid">
                      <div class="p-lab-cell">
                        <span class="p-lab-val">&lt; 38°C</span>
                        <span class="p-lab-lbl">Mortar Friction Temp</span>
                      </div>
                      <div class="p-lab-cell">
                        <span class="p-lab-val">0.00 PPM</span>
                        <span class="p-lab-lbl">Hexane Bath Wash</span>
                      </div>
                      <div class="p-lab-cell">
                        <span class="p-lab-val">14 RPM</span>
                        <span class="p-lab-lbl">Vaagai Pestle Speed</span>
                      </div>
                      <div class="p-lab-cell">
                        <span class="p-lab-val">0 Old Stock</span>
                        <span class="p-lab-lbl">Direct Farm Micro-Batch</span>
                      </div>
                    </div>
                    <div class="p-lab-cert-footer">
                      <span>✓ 100% Free of Palm Oil Blends, Synthetic TBHQ, and Bleaching Clays.</span>
                    </div>
                  </div>

                </div>
              </div>

            </div>
          </article>
        {% endfor %}
      {% else %}
        <div style="text-align:center; padding:5rem 2rem;">
          <p style="color:var(--p-text-muted);">Syncing reserve catalogue...</p>
        </div>
      {% endif %}
    </div>

  </div>
</section>

<script>
/* ===================================================================
   PURATHANA MONUMENTAL INTERACTIVE LOGIC
   1. Scroll-Driven Reveal (IntersectionObserver)
   2. 3D Dynamic Spring Tilt Physics (Mouse & Touch)
   3. Live Variant Selection & AJAX Cart Integration
   =================================================================== */

// 1. Scroll-Driven Reveal
function initScrollReveals() {
  const stages = document.querySelectorAll('.p-monument-stage');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

    stages.forEach(st => observer.observe(st));
  } else {
    stages.forEach(st => st.classList.add('is-revealed'));
  }
}

// 2. 3D Spring Tilt Physics (Inspired by 3D_CARD)
function initMonument3DTilt() {
  const pedestals = document.querySelectorAll('.p-monument-pedestal');
  pedestals.forEach(ped => {
    if (ped.dataset.tiltReady) return;
    ped.dataset.tiltReady = 'true';

    const bottleWrap = ped.querySelector('.p-monument-bottle-wrap');
    if (!bottleWrap) return;

    let rotX = 0, rotY = 0, targetX = 0, targetY = 0;
    let isTracking = false, rafId = null;

    function loop() {
      rotX += (targetX - rotX) * 0.14;
      rotY += (targetY - rotY) * 0.14;

      bottleWrap.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) scale3d(1.025, 1.025, 1.025)`;

      const diff = Math.abs(targetX - rotX) + Math.abs(targetY - rotY);
      if (isTracking || diff > 0.01) {
        rafId = requestAnimationFrame(loop);
      } else {
        rafId = null;
        if (!isTracking) {
          bottleWrap.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }
      }
    }

    function updateCoords(clientX, clientY) {
      const rect = ped.getBoundingClientRect();
      const x = clientX - rect.left;
      const y = clientY - rect.top;
      const midX = rect.width / 2;
      const midY = rect.height / 2;

      targetX = ((y - midY) / midY) * -12;
      targetY = ((x - midX) / midX) * 12;

      ped.style.setProperty('--mouse-x', `${x}px`);
      ped.style.setProperty('--mouse-y', `${y}px`);

      if (!rafId) rafId = requestAnimationFrame(loop);
    }

    ped.addEventListener('mouseenter', () => {
      isTracking = true;
      if (!rafId) rafId = requestAnimationFrame(loop);
    });

    ped.addEventListener('mousemove', e => {
      isTracking = true;
      updateCoords(e.clientX, e.clientY);
    });

    ped.addEventListener('mouseleave', () => {
      isTracking = false;
      targetX = 0;
      targetY = 0;
      if (!rafId) rafId = requestAnimationFrame(loop);
    });

    // Touch gesture support
    ped.addEventListener('touchstart', e => {
      if (e.touches.length === 1) {
        isTracking = true;
        updateCoords(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    ped.addEventListener('touchmove', e => {
      if (e.touches.length === 1 && isTracking) {
        updateCoords(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    ped.addEventListener('touchend', () => {
      isTracking = false;
      targetX = 0;
      targetY = 0;
      if (!rafId) rafId = requestAnimationFrame(loop);
    });
  });
}

// 3. Lab Specs Slide-in Drawer Toggle
function toggleMonumentLabSpecs(productId) {
  const drawer = document.getElementById('lab-drawer-hello' + productId) || document.getElementById('lab-drawer-' + productId);
  if (!drawer) return;
  drawer.classList.toggle('active');
}

// 4. Live Variant Selection
function onMonumentPillSelect(btn) {
  const productId = btn.dataset.productId;
  const variantId = btn.dataset.variantId;
  const priceFormatted = btn.dataset.price;
  const stage = document.getElementById('product-stage-' + productId);
  if (!stage) return;

  stage.querySelectorAll('.p-monument-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');

  const priceEl = document.getElementById('monument_price_' + productId);
  if (priceEl) priceEl.textContent = priceFormatted;

  const addBtn = document.getElementById('btn_monument_add_' + productId);
  if (addBtn) addBtn.dataset.activeVariantId = variantId;
}

// 5. AJAX Add to Bag
function addMonumentVariantToBag(productId) {
  const stage = document.getElementById('product-stage-' + productId);
  if (!stage) return;

  const activePill = stage.querySelector('.p-monument-pill.active');
  const variantId = activePill ? activePill.dataset.variantId : null;
  const btn = document.getElementById('btn_monument_add_' + productId);

  if (!variantId || !btn) return;

  const origHtml = btn.innerHTML;
  btn.innerHTML = '<span>Adding...</span>';
  btn.disabled = true;

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  })
  .then(res => res.json())
  .then(data => {
    btn.innerHTML = '<span>Added ✓</span>';
    setTimeout(() => {
      btn.innerHTML = origHtml;
      btn.disabled = false;
    }, 1200);

    // If theme has a drawer or cart event
    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
  })
  .catch(err => {
    console.error('Add to bag error:', err);
    btn.innerHTML = origHtml;
    btn.disabled = false;
  });
}

document.addEventListener('DOMContentLoaded', () => {
  initScrollReveals();
  initMonument3DTilt();
});
if (document.readyState === 'complete' || document.readyState === 'interactive') {
  setTimeout(() => {
    initScrollReveals();
    initMonument3DTilt();
  }, 100);
}
</script>

{% schema %}
{
  "name": "Purathana Catalog",
  "settings": [],
  "presets": [
    {
      "name": "Purathana Catalog"
    }
  ]
}
{% endschema %}
