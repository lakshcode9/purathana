<!-- ===================================================================
     PURATHANA TRUST ARCHITECTURE: FOUR PILLARS OF CRAFT
     Apple-style minimalist horizontal spec strip.
     =================================================================== -->

<section class="p-pillars-section" id="process">
  <div class="purathana-container">
    <div class="p-pillars-grid">
      <!-- Pillar 1 -->
      <div class="p-pillar-item">
        <div class="p-pillar-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 3"></path>
          </svg>
        </div>
        <div class="p-pillar-content">
          <h4 class="p-pillar-title">14 RPM Cold Press</h4>
          <p class="p-pillar-desc">Slow-turning Vaagai wood absorbs friction heat. Crushed strictly below 38°C.</p>
        </div>
      </div>

      <!-- Pillar 2: Small Batches · Zero Old Stock (Explicit Requirement) -->
      <div class="p-pillar-item">
        <div class="p-pillar-icon" style="color:#C88732; border-color:rgba(200,135,50,0.3);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <div class="p-pillar-content">
          <h4 class="p-pillar-title">Fresh Small Batches</h4>
          <p class="p-pillar-desc">Crushed on demand in micro-batches. We keep zero old stock or aged warehouse inventory.</p>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="p-pillar-item">
        <div class="p-pillar-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
        </div>
        <div class="p-pillar-content">
          <h4 class="p-pillar-title">0.00 PPM Solvents</h4>
          <p class="p-pillar-desc">Free from chemical hexane, caustic soda wash, and palm blending.</p>
        </div>
      </div>

      <!-- Pillar 4 -->
      <div class="p-pillar-item">
        <div class="p-pillar-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <div class="p-pillar-content">
          <h4 class="p-pillar-title">Intact Bioactives</h4>
          <p class="p-pillar-desc">Preserves natural Tocopherols (Vitamin E), Phytosterols &amp; MUFA.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.p-pillars-section {
  padding: 3rem 0;
  background: #EFE2C6;
  border-block: 1px solid rgba(47, 41, 35, 0.1);
}

.p-pillars-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2.5rem;
}

.p-pillar-item {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
}

.p-pillar-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #FDF9F2;
  color: #5A1F22;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(90, 31, 34, 0.15);
}

.p-pillar-content {
  display: flex;
  flex-direction: column;
}

.p-pillar-title {
  font-family: 'Marcellus', Georgia, serif;
  font-size: 1.05rem;
  font-weight: 400;
  color: #5A1F22;
  margin: 0 0 0.35rem;
  letter-spacing: -0.01em;
}

.p-pillar-desc {
  font-size: 0.775rem;
  color: #2F2923;
  opacity: 0.85;
  line-height: 1.5;
  margin: 0;
}

@media (max-width: 1024px) {
  .p-pillars-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
}

@media (max-width: 640px) {
  .p-pillars-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}
</style>

{% schema %}
{
  "name": "Purathana Trust Pillars",
  "settings": [],
  "presets": [
    {
      "name": "Purathana Trust Pillars"
    }
  ]
}
{% endschema %}
