{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar p-announcement-marquee-bar spacing-style color-custom-{{ section.id }}"
  style="--border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
  aria-label="Current Announcements and Offers"
>
  <div class="p-marquee-track-outer">
    <div class="p-marquee-track">
      <!-- Set 1 of announcements -->
      <div class="p-marquee-segment">
        <span class="p-marquee-item">Complimentary Express Dispatch on Orders Over ₹999</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">Use Privilege Code <strong class="p-promo-code">FLAT10</strong> for 10% Off</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">Automatic 20% Volume Privilege on Orders Over ₹2,999</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">50 Vedic Loyalty Credits Upon Registration</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">100% Cold Pressed Extraction (&lt; 38°C) — Zero Old Stock</span>
        <span class="p-marquee-dot">·</span>
      </div>

      <!-- Set 2 (Duplicate for seamless continuous running loop) -->
      <div class="p-marquee-segment" aria-hidden="true">
        <span class="p-marquee-item">Complimentary Express Dispatch on Orders Over ₹999</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">Use Privilege Code <strong class="p-promo-code">FLAT10</strong> for 10% Off</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">Automatic 20% Volume Privilege on Orders Over ₹2,999</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">50 Vedic Loyalty Credits Upon Registration</span>
        <span class="p-marquee-dot">·</span>
        <span class="p-marquee-item">100% Cold Pressed Extraction (&lt; 38°C) — Zero Old Stock</span>
        <span class="p-marquee-dot">·</span>
      </div>
    </div>
  </div>
</aside>

<style>
  .p-announcement-marquee-bar {
    background-color: #28422D !important;
    color: #FAF5EB !important;
    padding: 0.65rem 0 !important;
    overflow: hidden !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    border-bottom: 1px solid rgba(200, 142, 53, 0.35) !important;
    position: relative !important;
    z-index: 100 !important;
  }

  .p-marquee-track-outer {
    width: 100% !important;
    overflow: hidden !important;
    white-space: nowrap !important;
    display: flex !important;
  }

  .p-marquee-track {
    display: inline-flex !important;
    white-space: nowrap !important;
    will-change: transform !important;
    animation: purathana-announcement-scroll 24s linear infinite !important;
  }

  .p-marquee-track:hover {
    animation-play-state: paused !important;
  }

  .p-marquee-segment {
    display: inline-flex !important;
    align-items: center !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }

  .p-marquee-item {
    font-family: var(--font-body--family, system-ui, -apple-system, sans-serif) !important;
    font-size: 0.74rem !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    font-weight: 500 !important;
    color: #FAF5EB !important;
    white-space: nowrap !important;
    padding: 0 0.25rem !important;
  }

  .p-promo-code {
    color: #E8B966 !important;
    font-weight: 700 !important;
    background: rgba(232, 185, 102, 0.15) !important;
    padding: 0.1rem 0.4rem !important;
    border-radius: 4px !important;
    border: 1px solid rgba(232, 185, 102, 0.3) !important;
  }

  .p-marquee-dot {
    color: #C88E35 !important;
    padding: 0 1.25rem !important;
    font-size: 0.75rem !important;
    line-height: 1 !important;
    vertical-align: middle !important;
    opacity: 0.9 !important;
  }

  @keyframes purathana-announcement-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Ensure smooth marquee on mobile screens */
  @media screen and (max-width: 768px) {
    .p-announcement-marquee-bar {
      padding: 0.55rem 0 !important;
    }
    .p-marquee-item {
      font-size: 0.68rem !important;
      letter-spacing: 0.09em !important;
    }
    .p-marquee-dot {
      padding: 0 0.85rem !important;
    }
    .p-marquee-track {
      animation-duration: 20s !important;
    }
  }
</style>

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default"
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar"
    }
  ]
}
{% endschema %}
