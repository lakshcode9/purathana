<!-- ===================================================================
     PURATHANA SIGNATURE HERITAGE FOOTER
     1:1 Mockup Replication: Deep Forest Green (#1E3522)
     Social Icons · Mountain Sketch & Logo · "Goodness in every drop"
     =================================================================== -->

<footer class="p-heritage-footer" id="site-footer">
  <div class="purathana-container">
    
    <!-- Primary Mockup Tier -->
    <div class="p-footer-primary-row">
      
      <!-- Left: Social Network Icons -->
      <div class="p-footer-col-social">
        <span class="p-footer-social-label">CONNECT WITH US</span>
        <div class="p-footer-social-icons">
          <!-- Instagram -->
          <a href="https://instagram.com" target="_blank" rel="noopener" class="p-social-link" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <!-- Facebook -->
          <a href="https://facebook.com" target="_blank" rel="noopener" class="p-social-link" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <!-- YouTube -->
          <a href="https://youtube.com" target="_blank" rel="noopener" class="p-social-link" aria-label="YouTube">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
          </a>
          <!-- X / Twitter -->
          <a href="https://x.com" target="_blank" rel="noopener" class="p-social-link" aria-label="Twitter">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Center: Mountain Lineart Sketch + PURATHANA Brand Identity -->
      <div class="p-footer-col-center">
        <!-- Mountain and Sun Heritage Lineart Icon -->
        <div class="p-footer-heritage-crest">
          <svg width="44" height="28" viewBox="0 0 60 36" fill="none" stroke="#FAF5EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <!-- Mountain Peaks -->
            <path d="M4 32 L22 8 L34 22 L44 14 L56 32 Z" />
            <!-- Sun Rays Above Peaks -->
            <path d="M22 4 L22 1" />
            <path d="M16 6 L14 4" />
            <path d="M28 6 L30 4" />
          </svg>
        </div>
        <div class="p-footer-brand-logo">
          <img src="{{ 'purathana-logo-official.png' | asset_url }}" alt="PURATHANA" style="max-height: 52px; width: auto; filter: brightness(0) invert(1);" />
        </div>
      </div>

      <!-- Right: Mockup Signature Cursive Script -->
      <div class="p-footer-col-script">
        <div class="p-footer-script-text">Goodness in every drop</div>
        <div class="p-footer-script-sub">Traditional Vaagai Wood Press</div>
      </div>

    </div>

    <!-- Secondary Tier: Navigation & Micro-batch Pledge -->
    <div class="p-footer-secondary-row">
      <div class="p-footer-nav-links">
        <a href="#our-oils" class="p-fnav-link">Our Oils</a>
        <a href="#story" class="p-fnav-link">Why Purathana</a>
        <a href="/policies/privacy-policy" class="p-fnav-link">Privacy Policy</a>
        <a href="/policies/terms-of-service" class="p-fnav-link">Terms of Service</a>
        <a href="/policies/shipping-policy" class="p-fnav-link">Shipping &amp; Returns</a>
      </div>
      
      <div class="p-footer-pledge">
        100% Pure · Zero Hexane · Cold Crushed &lt; 38°C · Direct From Indian Farms
      </div>
    </div>

    <!-- Tertiary Tier: Copyright -->
    <div class="p-footer-bottom-row">
      <p class="p-footer-copy">
        &copy; {{ 'now' | date: '%Y' }} Purathana Cold Pressed Oils. All rights reserved.
      </p>
      <p class="p-footer-dispatch">
        Authentic Indian Heritage · Vaagai Wood Cold Pressing
      </p>
    </div>

  </div>
</footer>

<style>
.p-heritage-footer {
  background-color: #1E3522;
  color: #FAF5EB;
  padding: 4.5rem 0 2.5rem;
  position: relative;
  overflow: hidden;
  border-top: 1px solid rgba(250, 245, 235, 0.12);
}

/* Primary Row: Left Social, Center Logo, Right Script */
.p-footer-primary-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 2rem;
  padding-bottom: 3.5rem;
  border-bottom: 1px solid rgba(250, 245, 235, 0.15);
}

/* Social Column */
.p-footer-col-social {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.85rem;
}

.p-footer-social-label {
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: rgba(250, 245, 235, 0.65);
  text-transform: uppercase;
}

.p-footer-social-icons {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.p-social-link {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid rgba(250, 245, 235, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FAF5EB;
  transition: all 0.25s ease;
}

.p-social-link:hover {
  background: rgba(250, 245, 235, 0.15);
  border-color: #FAF5EB;
  transform: translateY(-2px);
}

/* Center Logo Column */
.p-footer-col-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.p-footer-heritage-crest {
  margin-bottom: 0.6rem;
  opacity: 0.9;
}

.p-footer-brand-name {
  font-family: 'Marcellus', Georgia, serif;
  font-size: 1.85rem;
  letter-spacing: 0.24em;
  color: #FAF5EB;
  font-weight: 500;
  line-height: 1;
  margin-bottom: 0.35rem;
}

.p-footer-brand-sub {
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.68rem;
  letter-spacing: 0.32em;
  color: rgba(250, 245, 235, 0.7);
  text-transform: uppercase;
}

/* Right Cursive Script Column */
.p-footer-col-script {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
}

.p-footer-script-text {
  font-family: 'Marcellus', Georgia, serif;
  font-style: italic;
  font-size: 1.75rem;
  color: #FAF5EB;
  line-height: 1.2;
}

.p-footer-script-sub {
  font-family: var(--p-font-sans, system-ui);
  font-size: 0.72rem;
  color: rgba(250, 245, 235, 0.65);
  letter-spacing: 0.08em;
  margin-top: 0.25rem;
}

/* Secondary Row: Navigation & Pledge */
.p-footer-secondary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rem 0;
  border-bottom: 1px solid rgba(250, 245, 235, 0.1);
  flex-wrap: wrap;
  gap: 1.25rem;
}

.p-footer-nav-links {
  display: flex;
  align-items: center;
  gap: 1.75rem;
  flex-wrap: wrap;
}

.p-fnav-link {
  color: rgba(250, 245, 235, 0.75);
  text-decoration: none;
  font-size: 0.8rem;
  transition: color 0.2s ease;
}

.p-fnav-link:hover {
  color: #FAF5EB;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.p-footer-pledge {
  font-size: 0.75rem;
  color: rgba(250, 245, 235, 0.65);
  letter-spacing: 0.04em;
}

/* Bottom Row */
.p-footer-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 1.5rem;
  font-size: 0.72rem;
  color: rgba(250, 245, 235, 0.5);
  flex-wrap: wrap;
  gap: 0.75rem;
}

.p-footer-copy,
.p-footer-dispatch {
  margin: 0;
}

/* Mobile & Tablet Styles */
@media (max-width: 900px) {
  .p-heritage-footer {
    padding: 3rem 0 2rem;
  }
  .p-footer-primary-row {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 2.25rem;
    padding-bottom: 2.25rem;
  }
  .p-footer-col-social {
    align-items: center;
    order: 2;
  }
  .p-footer-col-center {
    order: 1;
  }
  .p-footer-col-script {
    align-items: center;
    text-align: center;
    order: 3;
  }
  .p-footer-secondary-row {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 1.5rem 0;
  }
  .p-footer-nav-links {
    justify-content: center;
    gap: 1.25rem;
  }
  .p-footer-bottom-row {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }
}
</style>

{% schema %}
{
  "name": "Purathana Heritage Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Purathana Heritage Footer"
    }
  ]
}
{% endschema %}
