<!-- ===================================================================
     PURATHANA BENTO GRID: THE ARCHITECTURE OF PURITY
     Apple-style technical breakdown of cold-pressed integrity
     =================================================================== -->

<section class="p-bento-section">
  <div class="purathana-container">
    <div class="p-section-heading">
      <div class="p-eyebrow">Engineering Purity</div>
      <h2 class="p-section-title">The Science of The Unrefined.</h2>
      <p class="p-section-sub">
        Standard industrial oils undergo 220°C thermal refining, hexane wash, and acid neutralization. 
        Purathana is harvested purely through mechanical pressure.
      </p>
    </div>

    <div class="p-bento-grid">
      <!-- Card 1: Thermal Boundary -->
      <div class="p-bento-card p-card-span-7">
        <div>
          <div class="p-bento-num">&lt; 38°C</div>
          <h3 class="p-bento-h3">Body-Temp Living Crush</h3>
          <p class="p-bento-p">
            Vaagai wood absorbs friction heat. Native bioactive enzymes remain fully intact.
          </p>
        </div>
        <div style="margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--p-border-hairline); display:flex; gap:2rem;">
          <div>
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--p-text-muted);">Standard Refinery</div>
            <div style="font-weight:700; color:#7A2E25;">240°C · Denatured</div>
          </div>
          <div>
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--p-text-muted);">Purathana Press</div>
            <div style="font-weight:700; color:#7A8060;">36°C · Living Lipids</div>
          </div>
        </div>
      </div>

      <!-- Card 2: Zero Solvents -->
      <div class="p-bento-card p-card-span-5">
        <div>
          <div class="p-bento-num">0.00 <span style="font-size:1.5rem;">PPM</span></div>
          <h3 class="p-bento-h3">Zero Hexane Solvents</h3>
          <p class="p-bento-p">
            100% mechanical pressure. Zero petroleum solvents or acid wash.
          </p>
        </div>
        <div style="margin-top:1.5rem; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#C88732; font-weight:700;">
          ✓ Lab Chromatography Verified
        </div>
      </div>

      <!-- Card 3: Vaagai Mortar -->
      <div class="p-bento-card p-card-span-4">
        <div>
          <div class="p-bento-num">14 <span style="font-size:1.5rem;">RPM</span></div>
          <h3 class="p-bento-h3">Slow Wood Mortar</h3>
          <p class="p-bento-p">
            Single-stroke botanical extraction. Zero friction burn.
          </p>
        </div>
      </div>

      <!-- Card 4: Unfiltered Sedimentation -->
      <div class="p-bento-card p-card-span-8">
        <div>
          <div class="p-bento-num">7 Days</div>
          <h3 class="p-bento-h3">Natural Gravity Rest</h3>
          <p class="p-bento-p">
            Sun-settled gravitationally. Natural micro-cloudiness is your proof of raw virgin oil.
          </p>
        </div>
        <div style="margin-top:1.25rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
          <span style="font-size:0.75rem; color:#2F2923; background:#EFE2C6; padding:0.35rem 0.75rem; border-radius:9999px; font-weight:600;">Zero Bleaching Earth</span>
          <span style="font-size:0.75rem; color:#2F2923; background:#EFE2C6; padding:0.35rem 0.75rem; border-radius:9999px; font-weight:600;">Zero Synthetic TBHQ</span>
          <span style="font-size:0.75rem; color:#2F2923; background:#EFE2C6; padding:0.35rem 0.75rem; border-radius:9999px; font-weight:600;">Zero Palm Blending</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purathana Bento Specs",
  "settings": [],
  "presets": [
    {
      "name": "Purathana Bento Specs"
    }
  ]
}
{% endschema %}
