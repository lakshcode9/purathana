{% comment %}
  PURATHANA INTERACTIVE OIL SOMMELIER (AI GUIDANCE)
  SOW Requirements: AI Sales Guidance, Product Personalization, Guided Conversion
  Aesthetic: Apple Editorial Precision, Zero AI Slop
{% endcomment %}

<section class="purathana-sommelier-section" id="oil-sommelier">
  <div class="purathana-container">
    <div class="p-sommelier-header">
      <span class="p-sommelier-eyebrow">Interactive Concierge</span>
      <h2 class="p-sommelier-title">Find Your Sacred Nectar</h2>
      <p class="p-sommelier-subtitle">
        Every oil possesses a distinct thermal smoke boundary, viscosity, and fatty acid architecture. Let our sommelier match your culinary rituals.
      </p>
    </div>

    <div class="p-sommelier-card" id="SommelierCard">
      <!-- Progress Indicator -->
      <div class="p-sommelier-stepper">
        <div class="p-step-dot active" data-step="0">1</div>
        <div class="p-step-line"></div>
        <div class="p-step-dot" data-step="1">2</div>
        <div class="p-step-line"></div>
        <div class="p-step-dot" data-step="2">3</div>
      </div>

      <!-- Question Content Container -->
      <div id="SommelierStepContent">
        <!-- Rendered dynamically via JS -->
      </div>
    </div>
  </div>
</section>

<style>
.purathana-sommelier-section {
  padding: 6rem 0;
  background: var(--p-bg-canvas, #FBF9F5);
  font-family: var(--p-font-sans, -apple-system, sans-serif);
  color: var(--p-color-basalt, #111713);
  border-top: 1px solid var(--p-border-hairline, rgba(18, 24, 20, 0.08));
}

.p-sommelier-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 3.5rem;
}

.p-sommelier-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--p-color-basalt, #111613);
  margin-bottom: 0.75rem;
}

.p-sommelier-title {
  font-family: var(--p-font-display, "Syne", sans-serif);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.15;
  color: var(--p-color-basalt, #111713);
  margin-bottom: 1rem;
}

.p-sommelier-subtitle {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--p-text-muted, #7E8580);
}

.p-sommelier-card {
  max-width: 760px;
  margin: 0 auto;
  background: #FFFFFF;
  border-radius: var(--p-radius-lg, 16px);
  border: 1px solid var(--p-border-hairline, rgba(18, 24, 20, 0.08));
  box-shadow: 0 4px 20px rgba(17, 23, 19, 0.03);
  padding: 3rem 2.5rem;
}

.p-sommelier-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  margin-bottom: 2.5rem;
}

.p-step-dot {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--p-text-muted, #7E8580);
  background: var(--p-bg-warm, #F4EFE6);
  border: 1px solid var(--p-border-hairline, rgba(18, 24, 20, 0.08));
  transition: all 250ms ease;
}

.p-step-dot.active {
  background: var(--p-color-basalt, #111713);
  color: #FFFFFF;
  border-color: var(--p-color-basalt, #111713);
}

.p-step-dot.completed {
  background: var(--p-color-basalt, #111713);
  color: #FFFFFF;
  border-color: var(--p-color-basalt, #111713);
}

.p-step-line {
  width: 48px;
  height: 1px;
  background: var(--p-border-hairline, rgba(18, 24, 20, 0.12));
}

.p-q-title {
  font-family: var(--p-font-display, "Syne", sans-serif);
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.015em;
  color: var(--p-color-basalt, #111713);
  text-align: center;
  margin-bottom: 0.5rem;
}

.p-q-desc {
  font-size: 0.875rem;
  color: var(--p-text-muted, #7E8580);
  text-align: center;
  margin-bottom: 2rem;
}

.p-q-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

@media (max-width: 640px) {
  .p-q-options {
    grid-template-columns: 1fr;
  }
  .p-sommelier-card {
    padding: 2rem 1.25rem;
  }
}

.p-q-opt-btn {
  background: var(--p-bg-warm, #F4EFE6);
  border: 1px solid var(--p-border-hairline, rgba(18, 24, 20, 0.08));
  border-radius: var(--p-radius-md, 10px);
  padding: 1.25rem;
  text-align: left;
  cursor: pointer;
  transition: all 200ms cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.p-q-opt-btn:hover {
  background: #FFFFFF;
  border-color: var(--p-color-basalt, #111713);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(17, 23, 19, 0.05);
}

.p-opt-tag {
  font-size: 0.6875rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--p-color-basalt, #111713);
  opacity: 0.6;
}

.p-opt-label {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--p-color-basalt, #111713);
}

.p-opt-detail {
  font-size: 0.8125rem;
  color: var(--p-text-muted, #7E8580);
  line-height: 1.4;
}

/* Result Box */
.p-result-view {
  text-align: center;
  animation: pFadeIn 300ms ease forwards;
}

@keyframes pFadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.p-result-badge {
  display: inline-block;
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--p-color-basalt, #111713);
  margin-bottom: 0.5rem;
}

.p-result-title {
  font-family: var(--p-font-display, "Syne", sans-serif);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--p-color-basalt, #111713);
  margin-bottom: 0.75rem;
}

.p-result-desc {
  font-size: 0.9375rem;
  color: var(--p-text-muted, #7E8580);
  max-width: 540px;
  margin: 0 auto 2rem;
  line-height: 1.6;
}

.p-result-product-card {
  background: var(--p-bg-warm, #F4EFE6);
  border-radius: var(--p-radius-md, 10px);
  padding: 1.5rem 2rem;
  max-width: 480px;
  margin: 0 auto 2rem;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  text-align: left;
  border: 1px solid var(--p-border-hairline, rgba(18, 24, 20, 0.08));
}

.p-result-thumb {
  width: 70px;
  height: 90px;
  object-fit: contain;
  background: #FFFFFF;
  border-radius: var(--p-radius-sm, 6px);
  padding: 0.4rem;
}

.p-result-meta-name {
  font-family: var(--p-font-display, "Syne", sans-serif);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--p-color-basalt, #111713);
  margin-bottom: 0.25rem;
}

.p-result-meta-price {
  font-family: var(--p-font-sans, -apple-system, sans-serif);
  font-size: 1rem;
  font-weight: 700;
  color: var(--p-color-basalt, #111713);
}

.p-result-cta-row {
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.p-btn-sommelier-add {
  background: var(--p-color-basalt, #111713);
  color: #FFFFFF;
  border: none;
  padding: 0.9rem 2rem;
  border-radius: var(--p-radius-sm, 6px);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 200ms ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.p-btn-sommelier-add:hover {
  background: var(--p-color-forest-deep, #16241C);
  transform: translateY(-2px);
}

.p-btn-restart {
  background: transparent;
  color: var(--p-text-muted, #7E8580);
  border: 1px solid var(--p-border-hairline, rgba(18, 24, 20, 0.12));
  padding: 0.9rem 1.5rem;
  border-radius: var(--p-radius-sm, 6px);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 200ms ease;
}

.p-btn-restart:hover {
  color: var(--p-color-basalt, #111713);
  border-color: var(--p-color-basalt, #111713);
}
</style>

<script>
(function() {
  const SOMMELIER_DATA = {
    questions: [
      {
        id: "usage",
        title: "What is your primary kitchen ritual?",
        desc: "Smoke points and lipid structures determine optimal cooking suitability.",
        options: [
          { tag: "Everyday Cooking", label: "Sautéing, Dal Tadka & Curries", detail: "Balanced smoke point with mild warm nuttiness.", oil: "groundnut" },
          { tag: "High-Heat Frying", label: "Deep Frying (Up to 230°C)", detail: "High thermal stability, zero smoke or odor breakdown.", oil: "groundnut" },
          { tag: "South Indian", label: "Dosas, Idli Podi & Rasam", detail: "Vedic Vaagai pressed gingelly oil with jaggery finish.", oil: "sesame" },
          { tag: "Authentic Pungent", label: "North Indian Curries & Pickles", detail: "Genuine Sinigrin enzyme jhaanjh with 0% dilution.", oil: "mustard" },
          { tag: "Raw & Wellness", label: "Hair Therapy, Pulling & Baby Care", detail: "Crystal-pure unfermented virgin coconut oil.", oil: "coconut" },
          { tag: "Heart-Conscious", label: "Light, Delicate Family Meals", detail: "High Linoleic Polyunsaturated fatty acid profile.", oil: "sunflower" }
        ]
      },
      {
        id: "health",
        title: "What is your primary wellness aspiration?",
        desc: "Cold extraction safeguards vital tocopherols and phytosterols.",
        options: [
          { tag: "Lipid Profile", label: "Cardiovascular Health & Healthy Arteries", detail: "Rich in plant phytosterols and natural Vitamin E.", oil: "sunflower" },
          { tag: "Cellular Energy", label: "Immunity, Metabolism & Gut MCTs", detail: "Pure Lauric Acid converted directly into cellular energy.", oil: "coconut" },
          { tag: "Ayurvedic Agni", label: "Bone Density & Joint Lubrication", detail: "Sesamol and sesamolin for structural body rejuvenation.", oil: "sesame" },
          { tag: "Internal Fire", label: "Digestive Stimulation & Immunity", detail: "Natural Allyl Isothiocyanate stimulates digestive enzymes.", oil: "mustard" }
        ]
      },
      {
        id: "flavor",
        title: "Which aromatic profile honors your palate?",
        desc: "Because we never chemically deodorize, natural aromatics remain intact.",
        options: [
          { tag: "Warm & Earthy", label: "Toasted Peanut Sweetness", detail: "Classic South Indian aroma that fills the kitchen.", oil: "groundnut" },
          { tag: "Sharp Pungent", label: "Authentic Kachi Ghani Jhaanjh", detail: "Sharp, pungent, and unmistakably authentic.", oil: "mustard" },
          { tag: "Fresh Copra", label: "Sun-Dried Kerala Coconut", detail: "Subtle, delicate sweetness with zero burnt odor.", oil: "coconut" },
          { tag: "Whisper Clean", label: "Ultra-Light & Non-Intrusive", detail: "Lets the natural flavors of your spices shine through.", oil: "sunflower" }
        ]
      }
    ],
    products: {
      "groundnut": {
        name: "Cold Pressed Groundnut Oil",
        variantId: 44299902648481,
        price: "₹380",
        tag: "Culinary Workhorse",
        desc: "Sourced from dryland Saurashtra bold peanuts. Exceptional 230°C thermal stability makes it the quintessential all-purpose oil.",
        image: "{{ 'purathana-half-groundnut.jpg' | asset_url }}"
      },
      "mustard": {
        name: "Cold Pressed Mustard Oil",
        variantId: 44299902681249,
        price: "₹395",
        tag: "Royal Pungency",
        desc: "Pressed from black and yellow mustard seeds in Rajasthan. High natural pungency that preserves pickles and enriches winter curries.",
        image: "{{ 'purathana-half-mustard.png' | asset_url }}"
      },
      "coconut": {
        name: "Cold Pressed Coconut Oil",
        variantId: 44299902714017,
        price: "₹450",
        tag: "Kerala Copra",
        desc: "Extracted from sulfur-free sun-dried Pollachi copra. Rich in Lauric Acid (MCTs), crystal-clear for cooking, oil pulling, and baby care.",
        image: "{{ 'purathana-half-coconut.png' | asset_url }}"
      },
      "sesame": {
        name: "Cold Pressed Sesame Oil",
        variantId: 44299902746785,
        price: "₹520",
        tag: "The Queen of Oils",
        desc: "Crushed with unrefined organic palm jaggery in Vaagai wood mortars. The sacred elixir for South Indian tadkas, dosas, and joint wellness.",
        image: "{{ 'purathana-half-sesame.png' | asset_url }}"
      },
      "sunflower": {
        name: "Cold Pressed Sunflower Oil",
        variantId: 44299902779553,
        price: "₹360",
        tag: "Light Lipid Profile",
        desc: "Extracted from non-GMO black sunflower seeds. Exceptionally light, neutral aroma with maximum natural Vitamin E for delicate family meals.",
        image: "{{ 'purathana-half-sunflower.png' | asset_url }}"
      }
    }
  };

  let currentStep = 0;
  let userChoices = [];

  function updateStepper() {
    const dots = document.querySelectorAll('.p-step-dot');
    dots.forEach((dot, idx) => {
      dot.classList.remove('active', 'completed');
      if (idx === currentStep) dot.classList.add('active');
      else if (idx < currentStep) dot.classList.add('completed');
    });
  }

  function renderQuestion() {
    updateStepper();
    const container = document.getElementById('SommelierStepContent');
    if (!container) return;

    if (currentStep >= SOMMELIER_DATA.questions.length) {
      renderRecommendation();
      return;
    }

    const q = SOMMELIER_DATA.questions[currentStep];
    let html = `
      <h3 class="p-q-title">${q.title}</h3>
      <p class="p-q-desc">${q.desc}</p>
      <div class="p-q-options">
    `;

    q.options.forEach((opt, idx) => {
      html += `
        <button type="button" class="p-q-opt-btn" onclick="window.PurathanaSommelierSelect('${opt.oil}')">
          <span class="p-opt-tag">${opt.tag}</span>
          <span class="p-opt-label">${opt.label}</span>
          <span class="p-opt-detail">${opt.detail}</span>
        </button>
      `;
    });

    html += `</div>`;
    container.innerHTML = html;
  }

  function renderRecommendation() {
    const container = document.getElementById('SommelierStepContent');
    if (!container) return;

    // Count frequency of chosen oils
    const tally = {};
    userChoices.forEach(oil => { tally[oil] = (tally[oil] || 0) + 1; });
    let bestOil = "groundnut";
    let maxVotes = -1;
    for (const [oil, count] of Object.entries(tally)) {
      if (count > maxVotes) {
        maxVotes = count;
        bestOil = oil;
      }
    }

    const rec = SOMMELIER_DATA.products[bestOil] || SOMMELIER_DATA.products["groundnut"];

    container.innerHTML = `
      <div class="p-result-view">
        <span class="p-result-badge">Personalized Harvest Recommendation</span>
        <h3 class="p-result-title">${rec.name}</h3>
        <p class="p-result-desc">${rec.desc}</p>

        <div class="p-result-product-card">
          <img src="${rec.image}" alt="${rec.name}" class="p-result-thumb" />
          <div class="p-result-meta">
            <div class="p-opt-tag">${rec.tag}</div>
            <div class="p-result-meta-name">${rec.name} (1L)</div>
            <div class="p-result-meta-price">${rec.price}</div>
          </div>
        </div>

        <div class="p-result-cta-row">
          <button type="button" class="p-btn-sommelier-add" onclick="window.PurathanaSommelierAdd('${rec.variantId}')">
            <span>Add Reserve Bottle to Bag</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
          <button type="button" class="p-btn-restart" onclick="window.PurathanaSommelierRestart()">
            <span>Retake Consultation</span>
          </button>
        </div>
      </div>
    `;
  }

  window.PurathanaSommelierSelect = function(oilKey) {
    userChoices.push(oilKey);
    currentStep++;
    renderQuestion();
  };

  window.PurathanaSommelierRestart = function() {
    currentStep = 0;
    userChoices = [];
    renderQuestion();
  };

  window.PurathanaSommelierAdd = function(variantId) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{ id: parseInt(variantId), quantity: 1 }]
      })
    })
    .then(res => res.json())
    .then(() => {
      if (typeof openPurathanaBag === 'function') {
        openPurathanaBag();
      } else {
        window.location.href = '/cart';
      }
    })
    .catch(err => {
      console.error('Sommelier add error:', err);
      window.location.href = '/cart';
    });
  };

  document.addEventListener('DOMContentLoaded', renderQuestion);
})();
</script>

{% schema %}
{
  "name": "Oil Sommelier",
  "tag": "section",
  "class": "section-purathana-sommelier",
  "settings": [],
  "presets": [
    {
      "name": "Oil Sommelier"
    }
  ]
}
{% endschema %}
